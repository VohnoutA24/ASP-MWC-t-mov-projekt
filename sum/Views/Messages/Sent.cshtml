@model List<sum.Models.Message>
@{
    ViewData["Title"] = "Odeslaná pošta";
    var activeTab = ViewBag.ActiveTab as string ?? "sent";
    var unreadCount = (int)(ViewBag.UnreadCount ?? 0);
}

<div class="messages-page">
    <div class="messages-header animate-in">
        <h1><i class="fas fa-paper-plane"></i> Odeslaná pošta</h1>
        <p>Vaše odeslané zprávy</p>
    </div>

    <div class="messages-layout animate-in animate-delay-1">
        <!-- Sidebar -->
        <aside class="messages-sidebar">
            <a asp-action="Compose" class="btn-compose" id="composeBtnSent">
                <i class="fas fa-pen-to-square"></i> Nová zpráva
            </a>
            <nav class="messages-nav">
                <a asp-action="Index" class="msg-nav-item @(activeTab == "inbox" ? "active" : "")" id="inboxLinkSent">
                    <i class="fas fa-inbox"></i>
                    <span>Příchozí</span>
                    @if (unreadCount > 0)
                    {
                        <span class="msg-badge">@unreadCount</span>
                    }
                </a>
                <a asp-action="Sent" class="msg-nav-item @(activeTab == "sent" ? "active" : "")" id="sentLinkSent">
                    <i class="fas fa-paper-plane"></i>
                    <span>Odeslaná</span>
                </a>
                <a asp-action="Trash" class="msg-nav-item @(activeTab == "trash" ? "active" : "")" id="trashLinkSent">
                    <i class="fas fa-trash-alt"></i>
                    <span>Koš</span>
                </a>
            </nav>
        </aside>

        <!-- Message List -->
        <div class="messages-content">
            @if (TempData["SuccessMessage"] != null)
            {
                <div class="alert-success">
                    <i class="fas fa-check-circle"></i> @TempData["SuccessMessage"]
                </div>
            }

            @if (Model.Count == 0)
            {
                <div class="messages-empty">
                    <div class="empty-icon">
                        <i class="fas fa-paper-plane"></i>
                    </div>
                    <h3>Žádné odeslané zprávy</h3>
                    <p>Zatím jste neodeslali žádnou zprávu.</p>
                    <a asp-action="Compose" class="btn-primary-custom">
                        <i class="fas fa-pen"></i> Napsat zprávu
                    </a>
                </div>
            }
            else
            {
                <div class="messages-list">
                    <!-- Selection Toolbar -->
                    <div class="messages-toolbar animate-in">
                        <div style="display: flex; align-items: center; gap: 0.75rem;">
                            <input type="checkbox" id="selectAllCheckbox" style="transform: scale(1.15); cursor: pointer;" />
                            <label for="selectAllCheckbox" style="font-size: 0.88rem; cursor: pointer; color: var(--text-secondary); user-select: none; font-weight: 600;">Vybrat vše</label>
                            <span id="selectedCountText" style="font-size: 0.88rem; font-weight: 600; color: var(--primary); display: none; margin-left: 0.5rem;">(vybráno: 0)</span>
                        </div>
                        <div style="display: flex; align-items: center; gap: 0.75rem;">
                            <div class="bulk-buttons" id="bulkButtons" style="display: flex; gap: 0.5rem; visibility: hidden; opacity: 0; transition: all 0.2s ease;">
                                <button type="button" id="bulkDeleteBtn" class="btn-bulk-action delete" title="Přesunout vybrané do koše">
                                    <i class="fas fa-trash-alt"></i> Smazat vybrané
                                </button>
                            </div>
                            <button type="button" class="btn-info-custom" id="mailboxInfoBtn" title="Nápověda k poště">
                                <i class="fas fa-circle-info"></i> Nápověda
                            </button>
                        </div>
                    </div>

                    @foreach (var msg in Model)
                    {
                        var isE2e = msg.Body != null && msg.Body.StartsWith("__E2E__:");

                        <div class="message-row @(isE2e ? "msg-row-e2e" : "")" 
                             id="msg-sent-@msg.Id"
                             @(isE2e ? Html.Raw($"data-e2e-payload=\"{msg.Body}\" data-is-sender=\"true\"") : null)>
                            <a asp-action="Read" asp-route-id="@msg.SecureId" class="msg-row-link">
                                <div class="msg-avatar sent-avatar">
                                    <i class="fas fa-user-circle"></i>
                                </div>
                                <div class="msg-info">
                                    <div class="msg-top">
                                        <span class="msg-sender">Komu: @(msg.Recipient?.FullName ?? msg.Recipient?.Email ?? "Neznámý")</span>
                                        <span class="msg-date">@msg.SentAt.ToCzechTime().ToString("dd.MM.yyyy HH:mm")</span>
                                    </div>
                                    <div class="msg-subject" style="display: flex; align-items: center; gap: 0.5rem;">
                                        <input type="checkbox" class="msg-select-checkbox" data-id="@msg.SecureId" onclick="event.stopPropagation();" style="cursor: pointer; transform: scale(1.1); margin-right: 0.25rem;" />
                                        <span class="subject-text">@(isE2e ? "Dešifrování..." : msg.Subject)</span>
                                        @if (msg.IsRead)
                                        {
                                            <span class="read-indicator" title="Přečteno"><i class="fas fa-check-double"></i></span>
                                        }
                                    </div>
                                    <div class="msg-preview">
                                        @if (msg.AttachmentFileName != null)
                                        {
                                            <i class="fas fa-paperclip msg-attachment-icon"></i>
                                        }
                                        <span class="msg-preview-text">
                                            @(isE2e ? "Dešifrování..." : (string.IsNullOrEmpty(msg.Body) ? "Žádný obsah" : (msg.Body.Length > 100 ? msg.Body.Substring(0, 100) + "…" : msg.Body)))
                                        </span>
                                    </div>
                                </div>
                            </a>
                            <div class="msg-actions" onclick="event.stopPropagation();">
                                <form asp-action="Delete" method="post" style="display: inline-block;" onsubmit="return confirm('Opravdu chcete tuto zprávu přesunout do koše?');">
                                    @Html.AntiForgeryToken()
                                    <input type="hidden" name="id" value="@msg.SecureId" />
                                    <button type="submit" class="btn-msg-action delete" title="Přesunout do koše">
                                        <i class="fas fa-trash-alt"></i>
                                    </button>
                                </form>
                            </div>
                        </div>
                    }
                </div>
            }
        </div>
    </div>
</div>

<form id="bulkActionForm" method="post" style="display: none;">
    @Html.AntiForgeryToken()
    <div id="bulkFormInputs"></div>
</form>

@section Scripts {
<script>
    document.addEventListener("DOMContentLoaded", function () {
        const selectAllCheckbox = document.getElementById("selectAllCheckbox");
        const msgCheckboxes = document.querySelectorAll(".msg-select-checkbox");
        const selectedCountText = document.getElementById("selectedCountText");
        const bulkButtons = document.getElementById("bulkButtons");
        
        const bulkDeleteBtn = document.getElementById("bulkDeleteBtn");
        
        const bulkActionForm = document.getElementById("bulkActionForm");
        const bulkFormInputs = document.getElementById("bulkFormInputs");

        function updateSelectionState() {
            const checkedCount = document.querySelectorAll(".msg-select-checkbox:checked").length;
            
            if (checkedCount > 0) {
                selectedCountText.textContent = `(vybráno: ${checkedCount})`;
                selectedCountText.style.display = "inline";
                bulkButtons.style.visibility = "visible";
                bulkButtons.style.opacity = "1";
            } else {
                selectedCountText.style.display = "none";
                bulkButtons.style.visibility = "hidden";
                bulkButtons.style.opacity = "0";
            }

            if (msgCheckboxes.length > 0) {
                selectAllCheckbox.checked = (checkedCount === msgCheckboxes.length);
            }
        }

        if (selectAllCheckbox) {
            selectAllCheckbox.addEventListener("change", function () {
                msgCheckboxes.forEach(cb => {
                    cb.checked = selectAllCheckbox.checked;
                });
                updateSelectionState();
            });
        }

        msgCheckboxes.forEach(cb => {
            cb.addEventListener("change", function () {
                updateSelectionState();
            });
        });

        function submitBulkAction(actionUrl, confirmMessage) {
            const checkedBoxes = document.querySelectorAll(".msg-select-checkbox:checked");
            if (checkedBoxes.length === 0) return;

            if (confirmMessage && !confirm(confirmMessage)) return;

            bulkFormInputs.innerHTML = "";
            checkedBoxes.forEach(cb => {
                const input = document.createElement("input");
                input.type = "hidden";
                input.name = "ids";
                input.value = cb.getAttribute("data-id");
                bulkFormInputs.appendChild(input);
            });

            bulkActionForm.action = actionUrl;
            bulkActionForm.submit();
        }

        if (bulkDeleteBtn) {
            bulkDeleteBtn.addEventListener("click", function () {
                submitBulkAction('@Url.Action("BulkDelete", "Messages")', "Opravdu chcete přesunout všechny vybrané zprávy do koše?");
            });
        }

        // Decrypt E2E message rows when E2E is ready
        document.addEventListener("e2e-ready", async function () {
            const privateKeySession = sessionStorage.getItem("decryptedPrivateKey");
            if (!privateKeySession) return;
            
            try {
                const privateKeyObj = await E2E.importPrivateKeyFromSession(privateKeySession);
                const e2eRows = document.querySelectorAll(".msg-row-e2e");
                
                for (const row of e2eRows) {
                    const payload = row.getAttribute("data-e2e-payload");
                    const isSender = row.getAttribute("data-is-sender") === "true";
                    
                    try {
                        const decrypted = await E2E.decryptMessage(payload, privateKeyObj, isSender);
                        if (decrypted) {
                            const subjectEl = row.querySelector(".subject-text");
                            const previewEl = row.querySelector(".msg-preview-text");
                            if (subjectEl) subjectEl.textContent = decrypted.subject;
                            if (previewEl) {
                                const snippet = decrypted.body.length > 100 ? decrypted.body.substring(0, 100) + "…" : decrypted.body;
                                previewEl.textContent = decrypted.body ? snippet : "Bez obsahu";
                            }
                        }
                    } catch (err) {
                        console.error("Failed to decrypt row message", err);
                        const subjectEl = row.querySelector(".subject-text");
                        if (subjectEl) subjectEl.textContent = "[Chyba dešifrování]";
                        const previewEl = row.querySelector(".msg-preview-text");
                        if (previewEl) previewEl.textContent = "Nelze dešifrovat zprávu.";
                    }
                }
            } catch (err) {
                console.error("E2E list decryption setup error", err);
            }
        });

        // Trigger manual check in case E2E initialized before event listener was registered
        if (sessionStorage.getItem("decryptedPrivateKey")) {
            document.dispatchEvent(new CustomEvent("e2e-ready"));
        }
    });
</script>
}
