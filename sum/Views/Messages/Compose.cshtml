@model sum.Models.ComposeMessageViewModel
@{
    ViewData["Title"] = "Nová zpráva";
    var users = ViewBag.Users as List<sum.Models.User> ?? new List<sum.Models.User>();
}

<script>
    window.currentUserId = @(int.Parse(User.FindFirst("UserId")?.Value ?? "0"));
</script>

<div class="messages-page">
    <div class="messages-header animate-in">
        <h1><i class="fas fa-pen-to-square"></i> Nová zpráva</h1>
        <p>Napište zprávu ostatním žákům nebo učitelům</p>
    </div>

    <div class="compose-container animate-in animate-delay-1">
        <div class="compose-card">
            <form asp-action="Compose" method="post" enctype="multipart/form-data" id="composeForm">
                @Html.AntiForgeryToken()

                <div asp-validation-summary="All" class="validation-summary-errors"></div>

                <!-- Recipient -->
                <div class="form-group">
                    <label asp-for="RecipientId">
                        <i class="fas fa-user"></i> Příjemce <span class="required">*</span>
                    </label>
                    <div class="recipient-select-wrapper">
                        <select asp-for="RecipientId" class="form-input compose-select" id="recipientSelect">
                            <option value="">— Vyberte příjemce —</option>
                            @foreach (var user in users)
                            {
                                var displayName = !string.IsNullOrEmpty(user.FullName)
                                    ? $"{user.FullName} ({user.Email})"
                                    : user.Email;
                                var roleBadge = user.Role == "Učitel" ? " 👨‍🏫" : "";
                                <option value="@user.Id"
                                    data-email="@user.Email"
                                    data-name="@(user.FullName ?? user.Email)"
                                    data-role="@user.Role"
                                    selected="@(Model.RecipientId == user.Id ? "selected" : null)">
                                    @displayName@roleBadge
                                </option>
                            }
                        </select>
                    </div>
                    <!-- E2E Status Indicator -->
                    <div id="e2eStatusIndicator" style="margin-top: 0.5rem; display: none;"></div>
                    <span asp-validation-for="RecipientId" class="field-validation-error"></span>
                </div>

                <!-- Subject -->
                <div class="form-group">
                    <label asp-for="Subject">
                        <i class="fas fa-heading"></i> Předmět <span class="required">*</span>
                    </label>
                    <div class="form-input-wrapper">
                        <input asp-for="Subject" class="form-input compose-input" placeholder="Předmět zprávy..." id="subjectInput" />
                    </div>
                    <span asp-validation-for="Subject" class="field-validation-error"></span>
                </div>

                <!-- Body -->
                <div class="form-group">
                    <label asp-for="Body">
                        <i class="fas fa-align-left"></i> Zpráva
                    </label>
                    <textarea asp-for="Body" class="form-input compose-textarea" rows="10" placeholder="Napište svoji zprávu..." id="bodyInput"></textarea>
                </div>

                <!-- Attachment -->
                <div class="form-group">
                    <label asp-for="Attachment">
                        <i class="fas fa-paperclip"></i> Příloha <span class="attachment-hint">(max 25 MB)</span>
                    </label>
                    <div class="attachment-drop-zone" id="dropZone">
                        <input asp-for="Attachment" type="file" class="attachment-file-input" id="attachmentInput" />
                        <div class="drop-zone-content" id="dropZoneContent">
                            <i class="fas fa-cloud-arrow-up"></i>
                            <p>Přetáhněte soubor sem nebo <span class="drop-zone-link">vyberte soubor</span></p>
                            <span class="drop-zone-hint">Maximální velikost: 25 MB</span>
                        </div>
                        <div class="drop-zone-file" id="dropZoneFile" style="display:none;">
                            <i class="fas fa-file"></i>
                            <div class="file-info">
                                <span class="file-name" id="fileName"></span>
                                <span class="file-size" id="fileSize"></span>
                            </div>
                            <button type="button" class="file-remove" id="fileRemove" title="Odstranit">
                                <i class="fas fa-times"></i>
                            </button>
                        </div>
                    </div>
                    <span asp-validation-for="Attachment" class="field-validation-error"></span>
                </div>

                <!-- Actions -->
                <div class="compose-actions">
                    <button type="submit" class="btn-send" id="sendBtn">
                        <i class="fas fa-paper-plane"></i> Odeslat zprávu
                    </button>
                    <a asp-action="Index" class="btn-cancel" id="cancelBtn">
                        <i class="fas fa-times"></i> Zrušit
                    </a>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
<script>
document.addEventListener('DOMContentLoaded', function() {
    const dropZone = document.getElementById('dropZone');
    const fileInput = document.getElementById('attachmentInput');
    const dropContent = document.getElementById('dropZoneContent');
    const dropFile = document.getElementById('dropZoneFile');
    const fileName = document.getElementById('fileName');
    const fileSize = document.getElementById('fileSize');
    const fileRemove = document.getElementById('fileRemove');

    function formatBytes(bytes) {
        if (bytes === 0) return '0 B';
        const k = 1024;
        const sizes = ['B', 'KB', 'MB', 'GB'];
        const i = Math.floor(Math.log(bytes) / Math.log(k));
        return parseFloat((bytes / Math.pow(k, i)).toFixed(1)) + ' ' + sizes[i];
    }

    function showFile(file) {
        if (file.size > 25 * 1024 * 1024) {
            alert('Soubor je příliš velký! Maximální velikost je 25 MB.');
            fileInput.value = '';
            return;
        }
        fileName.textContent = file.name;
        fileSize.textContent = formatBytes(file.size);
        dropContent.style.display = 'none';
        dropFile.style.display = 'flex';
    }

    function clearFile() {
        fileInput.value = '';
        dropContent.style.display = '';
        dropFile.style.display = 'none';
    }

    fileInput.addEventListener('change', function() {
        if (this.files.length > 0) {
            showFile(this.files[0]);
        }
    });

    fileRemove.addEventListener('click', clearFile);

    // Drag and drop
    ['dragenter', 'dragover', 'dragleave', 'drop'].forEach(evt => {
        dropZone.addEventListener(evt, e => { e.preventDefault(); e.stopPropagation(); });
    });

    ['dragenter', 'dragover'].forEach(evt => {
        dropZone.addEventListener(evt, () => dropZone.classList.add('drag-over'));
    });

    ['dragleave', 'drop'].forEach(evt => {
        dropZone.addEventListener(evt, () => dropZone.classList.remove('drag-over'));
    });

    dropZone.addEventListener('drop', function(e) {
        const files = e.dataTransfer.files;
        if (files.length > 0) {
            fileInput.files = files;
            showFile(files[0]);
        }
    });

    dropZone.addEventListener('click', function(e) {
        if (e.target !== fileRemove && !fileRemove.contains(e.target)) {
            fileInput.click();
        }
    });

    // E2E encryption and submission
    const composeForm = document.getElementById('composeForm');
    const sendBtn = document.getElementById('sendBtn');
    const recipientSelect = document.getElementById('recipientSelect');
    const e2eIndicator = document.getElementById('e2eStatusIndicator');

    let recipientE2EKey = null;
    let senderE2EKey = null;

    async function checkE2EStatus() {
        const recipientId = recipientSelect.value;
        if (!recipientId) {
            e2eIndicator.style.display = 'none';
            recipientE2EKey = null;
            return;
        }

        e2eIndicator.innerHTML = '<i class="fas fa-spinner fa-spin"></i> Ověřování zabezpečení...';
        e2eIndicator.style.display = 'block';
        e2eIndicator.className = '';
        e2eIndicator.style.color = 'var(--text-secondary)';

        try {
            const [recipKeyRes, senderKeyRes] = await Promise.all([
                fetch(`/Account/GetPublicKey?userId=${recipientId}`),
                fetch(`/Account/GetPublicKey?userId=${window.currentUserId}`)
            ]);

            if (!recipKeyRes.ok || !senderKeyRes.ok) {
                throw new Error();
            }

            const recipKeyData = await recipKeyRes.json();
            const senderKeyData = await senderKeyRes.json();

            recipientE2EKey = recipKeyData.publicKey || null;
            senderE2EKey = senderKeyData.publicKey || null;

            if (recipientE2EKey && senderE2EKey) {
                // Check if key changed compared to localStorage
                const oldKey = localStorage.getItem("pubkey_" + recipientId);
                if (oldKey && oldKey !== recipientE2EKey) {
                    e2eIndicator.innerHTML = `
                        <div class="alert alert-warning" style="margin: 0; padding: 0.65rem 0.85rem; font-size: 0.85rem; border-radius: var(--radius-sm); border-color: #fef08a; background: #fef9c3; color: #854d0e; display: flex; align-items: flex-start; gap: 0.5rem; line-height: 1.4;">
                            <i class="fas fa-triangle-exclamation" style="margin-top: 0.15rem;"></i>
                            <div>
                                <strong>Upozornění na změnu klíče:</strong> Bezpečnostní kód s tímto příjemcem se změnil. Příjemce si mohl vygenerovat nový klíč.
                            </div>
                        </div>
                    `;
                } else {
                    e2eIndicator.innerHTML = `
                        <div style="font-size: 0.85rem; color: #10b981; display: flex; align-items: center; gap: 0.4rem; font-weight: 600;">
                            <i class="fas fa-lock"></i> Koncové šifrování (E2E) aktivní
                        </div>
                    `;
                }
            } else if (!recipientE2EKey) {
                e2eIndicator.innerHTML = `
                    <div style="font-size: 0.85rem; color: #64748b; display: flex; align-items: center; gap: 0.4rem; font-weight: 500;">
                        <i class="fas fa-shield-halved"></i> Serverové zabezpečení (Příjemce nemá aktivované E2E)
                    </div>
                `;
            } else {
                e2eIndicator.innerHTML = `
                    <div style="font-size: 0.85rem; color: #64748b; display: flex; align-items: center; gap: 0.4rem; font-weight: 500;">
                        <i class="fas fa-shield-halved"></i> Serverové zabezpečení (Nemáte aktivované E2E)
                    </div>
                `;
            }
        } catch (err) {
            e2eIndicator.style.display = 'none';
            recipientE2EKey = null;
        }
    }

    if (recipientSelect) {
        recipientSelect.addEventListener('change', checkE2EStatus);
        // Run once on load for replies
        if (recipientSelect.value) {
            checkE2EStatus();
        }
    }

    if (composeForm && sendBtn) {
        composeForm.addEventListener('submit', async function (e) {
            e.preventDefault();

            // Check form validity first
            if (composeForm.checkValidity()) {
                if (typeof $ !== 'undefined' && typeof $.fn.valid === 'function') {
                    if (!$(composeForm).valid()) {
                        return;
                    }
                }
                
                const recipientId = recipientSelect.value;
                if (!recipientId) {
                    alert("Vyberte příjemce.");
                    return;
                }

                sendBtn.disabled = true;
                sendBtn.innerHTML = '<i class="fas fa-spinner fa-spin"></i> Odesílám...';
                sendBtn.style.opacity = '0.75';

                try {
                    // Fallback to server side encryption if E2E keys are not fully set up
                    if (!recipientE2EKey || !senderE2EKey) {
                        // Skip E2E encryption and submit directly
                        // Server will encrypt using the database data protection provider
                        composeForm.submit();
                        return;
                    }

                    // Otherwise E2E is active! Encrypt client-side
                    sendBtn.innerHTML = '<i class="fas fa-spinner fa-spin"></i> Šifrování zprávy...';

                    // 1. Import public keys
                    const recipientPubKey = await E2E.importPublicKey(recipientE2EKey);
                    const senderPubKey = await E2E.importPublicKey(senderE2EKey);

                    // Save key in localStorage to detect future resets
                    localStorage.setItem("pubkey_" + recipientId, recipientE2EKey);

                    // 2. Encrypt Subject and Body
                    const subject = document.getElementById('subjectInput').value;
                    const body = document.getElementById('bodyInput').value || "";

                    const fileInput = document.getElementById('attachmentInput');
                    let finalPayloadString = "";

                    // 3. Encrypt attachment if present
                    if (fileInput && fileInput.files.length > 0) {
                        const file = fileInput.files[0];
                        sendBtn.innerHTML = '<i class="fas fa-spinner fa-spin"></i> Šifrování přílohy...';
                        
                        const fileEncResult = await E2E.encryptFile(file, recipientPubKey, senderPubKey);
                        
                        // Set the encrypted file in file input
                        const encryptedFile = new File(
                            [fileEncResult.encryptedFileBlob], 
                            file.name + ".enc", 
                            { type: "application/octet-stream" }
                        );
                        
                        const dataTransfer = new DataTransfer();
                        dataTransfer.items.add(encryptedFile);
                        fileInput.files = dataTransfer.files;

                        // Create E2E message payload with embedded attachment payload
                        const mainPayloadString = await E2E.encryptMessage(subject, body, recipientPubKey, senderPubKey);
                        const mainPayload = JSON.parse(mainPayloadString.substring(8));
                        mainPayload.attachment = JSON.parse(fileEncResult.payloadJson);
                        
                        finalPayloadString = "__E2E__:" + JSON.stringify(mainPayload);
                    } else {
                        finalPayloadString = await E2E.encryptMessage(subject, body, recipientPubKey, senderPubKey);
                    }

                    // 4. Replace fields and submit
                    document.getElementById('subjectInput').value = "[Zašifrovaná zpráva]";
                    document.getElementById('bodyInput').value = finalPayloadString;

                    sendBtn.innerHTML = '<i class="fas fa-spinner fa-spin"></i> Odesílám...';
                    composeForm.submit();

                } catch (err) {
                    console.error("Encryption failed", err);
                    alert("Nepodařilo se odeslat zprávu: " + err.message);
                    restoreButton();
                }
            }
        });
    }

    function restoreButton() {
        sendBtn.disabled = false;
        sendBtn.innerHTML = '<i class="fas fa-paper-plane"></i> Odeslat zprávu';
        sendBtn.style.opacity = '1';
    }

    // Decrypt original E2E message if replying
    document.addEventListener("e2e-ready", async function () {
        const privateKeySession = sessionStorage.getItem("decryptedPrivateKey");
        if (!privateKeySession) return;

        const bodyInput = document.getElementById("bodyInput");
        const subjectInput = document.getElementById("subjectInput");
        if (!bodyInput) return;

        const bodyText = bodyInput.value;
        const e2eIndex = bodyText.indexOf("__E2E__:");
        if (e2eIndex === -1) return;

        const payload = bodyText.substring(e2eIndex);
        const prefix = bodyText.substring(0, e2eIndex);

        try {
            const privateKeyObj = await E2E.importPrivateKeyFromSession(privateKeySession);
            let decrypted = null;
            try {
                decrypted = await E2E.decryptMessage(payload, privateKeyObj, false);
            } catch (e) {
                try {
                    decrypted = await E2E.decryptMessage(payload, privateKeyObj, true);
                } catch (e2) {
                    console.error("Failed to decrypt reply body", e2);
                }
            }

            if (decrypted) {
                bodyInput.value = prefix + decrypted.body;
                if (subjectInput && subjectInput.value.includes("[Zašifrovaná zpráva]")) {
                    subjectInput.value = subjectInput.value.replace("[Zašifrovaná zpráva]", decrypted.subject);
                }
            }
        } catch (err) {
            console.error("Failed to decrypt prefilled reply", err);
        }
    });

    if (sessionStorage.getItem("decryptedPrivateKey")) {
        document.dispatchEvent(new CustomEvent("e2e-ready"));
    }
});
</script>
}
