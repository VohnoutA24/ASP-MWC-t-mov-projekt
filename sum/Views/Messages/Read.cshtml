@model sum.Models.Message
@{
    ViewData["Title"] = Model.Subject;
    var currentUserId = int.Parse(User.FindFirst("UserId")?.Value ?? "0");
    var isSender = Model.SenderId == currentUserId;
}

<div class="messages-page">
    <div class="messages-header animate-in">
        <div class="read-nav">
            @{
                var isDeletedBack = isSender ? Model.SenderDeleted : Model.RecipientDeleted;
            }
            @if (isDeletedBack)
            {
                <a asp-action="Trash" class="btn-back" id="backToTrash">
                    <i class="fas fa-arrow-left"></i> Zpět do koše
                </a>
            }
            else if (isSender)
            {
                <a asp-action="Sent" class="btn-back" id="backToSent">
                    <i class="fas fa-arrow-left"></i> Zpět na odeslanou poštu
                </a>
            }
            else
            {
                <a asp-action="Index" class="btn-back" id="backToInbox">
                    <i class="fas fa-arrow-left"></i> Zpět na příchozí poštu
                </a>
            }
        </div>
    </div>

    @{
        var isE2e = Model.Body != null && Model.Body.StartsWith("__E2E__:");
    }

    <div class="read-container animate-in animate-delay-1">
        <div class="read-card @(isE2e ? "read-card-e2e" : "")"
             data-is-e2e="@(isE2e ? "true" : "false")"
             data-e2e-payload="@(isE2e ? Model.Body : "")"
             data-is-sender="@(isSender ? "true" : "false")"
             data-download-url="@Url.Action("Download", new { id = Model.SecureId })"
             data-preview-url="@Url.Action("PublicAttachment", new { secureId = Model.SecureId })">
            <!-- Header -->
            <div class="read-card-header">
                <div style="display: flex; align-items: center; justify-content: space-between; flex-wrap: wrap; gap: 0.75rem; margin-bottom: 0.5rem;">
                    <h1 class="read-subject" id="readSubject" style="margin: 0;">@(isE2e ? "Dešifrování..." : Model.Subject)</h1>
                    <div id="encryptionBadgeContainer">
                        @if (isE2e)
                        {
                            <span class="badge-e2e" style="font-size: 0.78rem; padding: 0.2rem 0.5rem;"><i class="fas fa-lock"></i> E2E šifrování</span>
                        }
                        else
                        {
                            <span class="badge-server-enc" style="font-size: 0.78rem; padding: 0.2rem 0.5rem;"><i class="fas fa-shield-halved"></i> Serverové zabezpečení</span>
                        }
                    </div>
                </div>
                <div class="read-meta">
                    <div class="read-participants">
                        <div class="read-avatar">
                            @if (Model.Sender?.ProfilePicture != null)
                            {
                                <img src="@Url.Action("ProfilePicture", "Account", new { userId = Model.SenderId })" alt="Avatar" class="read-avatar-img" />
                            }
                            else
                            {
                                <i class="fas fa-user-circle"></i>
                            }
                        </div>
                        <div class="read-participant-info">
                            <div class="read-from">
                                <strong>Od:</strong> @(Model.Sender?.FullName ?? Model.Sender?.Email ?? "Neznámý")
                                <span class="read-email">(@(Model.Sender?.Email))</span>
                            </div>
                            <div class="read-to">
                                <strong>Komu:</strong> @(Model.Recipient?.FullName ?? Model.Recipient?.Email ?? "Neznámý")
                                <span class="read-email">(@(Model.Recipient?.Email))</span>
                            </div>
                        </div>
                    </div>
                    <div class="read-date">
                        <i class="fas fa-clock"></i>
                        @Model.SentAt.ToCzechTime().ToString("dd. MMMM yyyy, HH:mm")
                    </div>
                </div>
            </div>

            <!-- Body -->
            <div class="read-body">
                @if (isE2e)
                {
                    <pre class="read-body-text" id="readBodyText">Dešifrování zprávy...</pre>
                }
                else if (!string.IsNullOrEmpty(Model.Body))
                {
                    <pre class="read-body-text">@Model.Body</pre>
                }
                else
                {
                    <p class="read-no-body"><em>Tato zpráva nemá žádný obsah.</em></p>
                }
            </div>

            <!-- Attachment -->
            @if (Model.AttachmentFileName != null)
            {
                <div class="read-attachment" id="attachmentArea" style="@(isE2e ? "display: none;" : "")">
                    <div class="attachment-card">
                        <div class="attachment-icon">
                            <i class="fas fa-file"></i>
                        </div>
                        <div class="attachment-info">
                            <span class="attachment-name">@Model.AttachmentFileName</span>
                            <span class="attachment-size">
                                @{
                                    var sizeKb = (Model.AttachmentSize ?? 0) / 1024.0;
                                    var sizeMb = sizeKb / 1024.0;
                                    var sizeText = sizeMb >= 1 ? $"{sizeMb:F1} MB" : $"{sizeKb:F0} KB";
                                }
                                @sizeText
                            </span>
                        </div>
                        <a asp-action="Download" asp-route-id="@Model.SecureId" class="attachment-download" id="downloadAttachment">
                            <i class="fas fa-download"></i> Stáhnout
                        </a>
                    </div>

                    @if (Model.AttachmentContentType != null && Model.AttachmentContentType.StartsWith("image/"))
                    {
                        <div class="attachment-image-preview mt-3 text-center" style="margin-top: 1.25rem; border-top: 1px dashed var(--border); padding-top: 1.25rem;">
                            <img src="@Url.Action("PublicAttachment", "Messages", new { secureId = Model.SecureId, fileName = Model.AttachmentFileName })" alt="@Model.AttachmentFileName" class="img-fluid rounded" style="max-height: 450px; max-width: 100%; border: 1px solid var(--border); box-shadow: var(--shadow-sm); object-fit: contain;" />
                        </div>
                    }
                    else if (Model.AttachmentContentType != null && Model.AttachmentContentType.StartsWith("video/"))
                    {
                        <div class="attachment-video-preview mt-3 text-center" style="margin-top: 1.25rem; border-top: 1px dashed var(--border); padding-top: 1.25rem;">
                            <video src="@Url.Action("PublicAttachment", "Messages", new { secureId = Model.SecureId, fileName = Model.AttachmentFileName })" controls class="img-fluid rounded" style="max-height: 450px; max-width: 100%; border: 1px solid var(--border); box-shadow: var(--shadow-sm);" />
                        </div>
                    }
                </div>

                @if (isE2e)
                {
                    <div class="read-attachment" id="e2eAttachmentArea">
                        <div class="attachment-card">
                            <div class="attachment-icon">
                                <i class="fas fa-file"></i>
                            </div>
                            <div class="attachment-info">
                                <span class="attachment-name" id="e2eAttachmentName">Načítání přílohy...</span>
                                <span class="attachment-size" id="e2eAttachmentSize">...</span>
                            </div>
                            <button type="button" class="attachment-download" id="e2eAttachmentDownload" style="background: none; border: none; color: var(--primary); font-weight: 600; display: flex; align-items: center; gap: 0.35rem;">
                                <i class="fas fa-download"></i> Stáhnout
                            </button>
                        </div>
                        <div id="e2eAttachmentPreviewContainer" class="text-center" style="display: none; margin-top: 1.25rem; border-top: 1px dashed var(--border); padding-top: 1.25rem;">
                            <!-- Previews injected here -->
                        </div>
                    </div>
                }
            }

            <!-- Actions -->
            <div class="read-actions" style="display: flex; gap: 0.5rem; flex-wrap: wrap; margin-top: 1.5rem;">
                @{
                    var isDeleted = isSender ? Model.SenderDeleted : Model.RecipientDeleted;
                }
                
                @if (isDeleted)
                {
                    <form asp-action="Restore" method="post" class="d-inline">
                        @Html.AntiForgeryToken()
                        <input type="hidden" name="id" value="@Model.SecureId" />
                        <button type="submit" class="btn-primary-custom" style="padding: 0.5rem 1.25rem; font-size: 0.88rem; border-radius: var(--radius-sm); border: none;">
                            <i class="fas fa-undo"></i> Obnovit z koše
                        </button>
                    </form>
                    
                    <form asp-action="DeletePermanently" method="post" class="d-inline" onsubmit="return confirm('Opravdu chcete tuto zprávu trvale smazat?');">
                        @Html.AntiForgeryToken()
                        <input type="hidden" name="id" value="@Model.SecureId" />
                        <button type="submit" class="btn-logout" style="padding: 0.5rem 1.25rem; font-size: 0.88rem; border-radius: var(--radius-sm); border-color: #fecaca; background: #fef2f2; color: #b91c1c;">
                            <i class="fas fa-trash-alt"></i> Smazat trvale
                        </button>
                    </form>
                }
                else
                {
                    @if (!isSender)
                    {
                        <a asp-action="Compose" asp-route-replyTo="@Model.SecureId" class="btn-reply" id="replyBtn" style="border-radius: var(--radius-sm); font-size: 0.88rem; padding: 0.5rem 1.25rem;">
                            <i class="fas fa-reply"></i> Odpovědět
                        </a>
                    }
                    
                    <form asp-action="Delete" method="post" class="d-inline" onsubmit="return confirm('Opravdu chcete tuto zprávu přesunout do koše?');">
                        @Html.AntiForgeryToken()
                        <input type="hidden" name="id" value="@Model.SecureId" />
                        <button type="submit" class="btn-logout" style="padding: 0.5rem 1.25rem; font-size: 0.88rem; border-radius: var(--radius-sm); border-color: #fecaca; background: #fef2f2; color: #b91c1c;">
                            <i class="fas fa-trash-alt"></i> Smazat
                        </button>
                    </form>
                }
            </div>
        </div>
    </div>
</div>

@section Scripts {
<script>
document.addEventListener("DOMContentLoaded", function() {
    const card = document.querySelector(".read-card-e2e");
    if (!card) return;

    document.addEventListener("e2e-ready", async function () {
        const privateKeySession = sessionStorage.getItem("decryptedPrivateKey");
        if (!privateKeySession) return;
        
        try {
            const privateKeyObj = await E2E.importPrivateKeyFromSession(privateKeySession);
            const payload = card.getAttribute("data-e2e-payload");
            const isSender = card.getAttribute("data-is-sender") === "true";
            
            const decrypted = await E2E.decryptMessage(payload, privateKeyObj, isSender);
            if (decrypted) {
                // Update UI in-place
                document.getElementById("readSubject").textContent = decrypted.subject;
                document.title = decrypted.subject + " - ZŠ Chvalkovice";
                document.getElementById("readBodyText").textContent = decrypted.body;
                
                // Check if E2E payload has attachment metadata
                const payloadJson = JSON.parse(payload.substring(8));
                if (payloadJson.attachment) {
                    const attachmentMetadata = await E2E.decryptFileMetadata(
                        JSON.stringify(payloadJson.attachment), 
                        privateKeyObj, 
                        isSender
                    );
                    
                    if (attachmentMetadata) {
                        const nameEl = document.getElementById("e2eAttachmentName");
                        const sizeEl = document.getElementById("e2eAttachmentSize");
                        const downloadBtn = document.getElementById("e2eAttachmentDownload");
                        
                        nameEl.textContent = attachmentMetadata.name;
                        
                        // Try to get size from model
                        const sizeKb = @(Model.AttachmentSize ?? 0) / 1024.0;
                        const sizeMb = sizeKb / 1024.0;
                        const sizeText = sizeMb >= 1 ? sizeMb.toFixed(1) + " MB" : sizeKb.toFixed(0) + " KB";
                        sizeEl.textContent = sizeText;
                        
                        // Handle download
                        const downloadUrl = card.getAttribute("data-download-url");
                        downloadBtn.onclick = async function() {
                            downloadBtn.disabled = true;
                            downloadBtn.innerHTML = '<i class="fas fa-spinner fa-spin"></i> Stahování...';
                            
                            try {
                                const response = await fetch(downloadUrl);
                                if (!response.ok) throw new Error("Chyba při stahování souboru.");
                                const encryptedBuffer = await response.arrayBuffer();
                                
                                const decryptedBlob = await E2E.decryptFile(
                                    encryptedBuffer, 
                                    JSON.stringify(payloadJson.attachment), 
                                    privateKeyObj, 
                                    isSender
                                );
                                
                                // Trigger client-side file save
                                const blobUrl = URL.createObjectURL(decryptedBlob);
                                const a = document.createElement("a");
                                a.href = blobUrl;
                                a.download = attachmentMetadata.name;
                                document.body.appendChild(a);
                                a.click();
                                document.body.removeChild(a);
                                URL.revokeObjectURL(blobUrl);
                            } catch (err) {
                                console.error(err);
                                alert("Chyba při stahování nebo dešifrování přílohy.");
                            } finally {
                                downloadBtn.disabled = false;
                                downloadBtn.innerHTML = '<i class="fas fa-download"></i> Stáhnout';
                            }
                        };
                        
                        // Previews
                        if (attachmentMetadata.type.startsWith("image/") || attachmentMetadata.type.startsWith("video/")) {
                            const previewContainer = document.getElementById("e2eAttachmentPreviewContainer");
                            previewContainer.style.display = "block";
                            previewContainer.innerHTML = '<i class="fas fa-spinner fa-spin"></i> Načítání náhledu...';
                            
                            try {
                                const response = await fetch(downloadUrl);
                                if (response.ok) {
                                    const encryptedBuffer = await response.arrayBuffer();
                                    const decryptedBlob = await E2E.decryptFile(
                                        encryptedBuffer, 
                                        JSON.stringify(payloadJson.attachment), 
                                        privateKeyObj, 
                                        isSender
                                    );
                                    
                                    const blobUrl = URL.createObjectURL(decryptedBlob);
                                    if (attachmentMetadata.type.startsWith("image/")) {
                                        previewContainer.innerHTML = `<img src="${blobUrl}" alt="${attachmentMetadata.name}" class="img-fluid rounded" style="max-height: 450px; max-width: 100%; border: 1px solid var(--border); box-shadow: var(--shadow-sm); object-fit: contain;" />`;
                                    } else {
                                        previewContainer.innerHTML = `<video src="${blobUrl}" controls class="img-fluid rounded" style="max-height: 450px; max-width: 100%; border: 1px solid var(--border); box-shadow: var(--shadow-sm);" />`;
                                    }
                                }
                            } catch (err) {
                                console.error("Preview load failed", err);
                                previewContainer.style.display = "none";
                            }
                        }
                    }
                }
            }
        } catch (err) {
            console.error("E2E message decryption error", err);
            document.getElementById("readSubject").textContent = "[Chyba dešifrování]";
            document.getElementById("readBodyText").textContent = "Zprávu se nepodařilo dešifrovat.";
        }
    });

    if (sessionStorage.getItem("decryptedPrivateKey")) {
        document.dispatchEvent(new CustomEvent("e2e-ready"));
    }
});
</script>
}
