@model List<sum.Models.Message>
@{
    ViewData["Title"] = ViewBag.ActiveTab as string == "trash" ? "Koš" : "Příchozí pošta";
    var activeTab = ViewBag.ActiveTab as string ?? "inbox";
    var unreadCount = (int)(ViewBag.UnreadCount ?? 0);
    var currentUserId = int.Parse(User.FindFirst("UserId")?.Value ?? "0");
}

<div class="messages-page">
    <div class="messages-header animate-in">
        <h1><i class="fas fa-envelope"></i> Školní pošta</h1>
        <p>@(activeTab == "trash" ? "Smazané zprávy (budou trvale smazány po 15 dnech)" : "Vaše příchozí zprávy")</p>
    </div>

    <div class="messages-layout animate-in animate-delay-1">
        <!-- Sidebar -->
        <aside class="messages-sidebar">
            <a asp-action="Compose" class="btn-compose" id="composeBtn">
                <i class="fas fa-pen-to-square"></i> Nová zpráva
            </a>
            <nav class="messages-nav">
                <a asp-action="Index" class="msg-nav-item @(activeTab == "inbox" ? "active" : "")" id="inboxLink">
                    <i class="fas fa-inbox"></i>
                    <span>Příchozí</span>
                    @if (unreadCount > 0)
                    {
                        <span class="msg-badge">@unreadCount</span>
                    }
                </a>
                <a asp-action="Sent" class="msg-nav-item @(activeTab == "sent" ? "active" : "")" id="sentLink">
                    <i class="fas fa-paper-plane"></i>
                    <span>Odeslaná</span>
                </a>
                <a asp-action="Trash" class="msg-nav-item @(activeTab == "trash" ? "active" : "")" id="trashLink">
                    <i class="fas fa-trash-alt"></i>
                    <span>Koš</span>
                </a>
            </nav>
        </aside>

        <!-- Message List -->
        <div class="messages-content">
            @if (TempData["SuccessMessage"] != null)
            {
                <div class="alert-success">
                    <i class="fas fa-check-circle"></i> @TempData["SuccessMessage"]
                </div>
            }

            @if (activeTab == "trash" && Model.Count > 0)
            {
                <div class="trash-toolbar animate-in" style="display: flex; justify-content: flex-end; margin-bottom: 1rem;">
                    <form asp-action="EmptyTrash" method="post" onsubmit="return confirm('Opravdu chcete vysypat celý koš? Tato akce je nevratná.');">
                        @Html.AntiForgeryToken()
                        <button type="submit" class="btn-logout" style="padding: 0.5rem 1.2rem; font-size: 0.88rem; gap: 0.5rem; display: flex; align-items: center; border-radius: var(--radius-sm);">
                            <i class="fas fa-trash-alt"></i> Vysypat koš
                        </button>
                    </form>
                </div>
            }

            @if (Model.Count == 0)
            {
                <div class="messages-empty">
                    <div class="empty-icon">
                        <i class="fas @(activeTab == "trash" ? "fa-trash-alt" : "fa-inbox")"></i>
                    </div>
                    <h3>@(activeTab == "trash" ? "Koš je prázdný" : "Žádné zprávy")</h3>
                    <p>@(activeTab == "trash" ? "Nemáte žádné smazané zprávy. Zprávy přesunuté do koše jsou po 15 dnech automaticky odstraněny." : "Vaše schránka je prázdná. Začněte konverzaci!")</p>
                    @if (activeTab != "trash")
                    {
                        <a asp-action="Compose" class="btn-primary-custom">
                            <i class="fas fa-pen"></i> Napsat zprávu
                        </a>
                    }
                </div>
            }
            else
            {
                <div class="messages-list">
                    @foreach (var msg in Model)
                    {
                        var isSentByMe = msg.SenderId == currentUserId;
                        var isUnreadIncoming = !msg.IsRead && !isSentByMe;

                        <div class="message-row @(isUnreadIncoming ? "unread" : "")" id="msg-@msg.Id">
                            <a asp-action="Read" asp-route-id="@msg.SecureId" class="msg-row-link">
                                <div class="msg-avatar @(isSentByMe ? "sent-avatar" : "")">
                                    <i class="fas fa-user-circle"></i>
                                </div>
                                <div class="msg-info">
                                    <div class="msg-top">
                                        <span class="msg-sender">
                                            @if (isSentByMe)
                                            {
                                                @:Komu: @(msg.Recipient?.FullName ?? msg.Recipient?.Email ?? "Neznámý")
                                            }
                                            else
                                            {
                                                @(msg.Sender?.FullName ?? msg.Sender?.Email ?? "Neznámý")
                                            }
                                        </span>
                                        <span class="msg-date">@msg.SentAt.ToLocalTime().ToString("dd.MM.yyyy HH:mm")</span>
                                    </div>
                                    <div class="msg-subject">
                                        @if (isUnreadIncoming)
                                        {
                                            <span class="unread-dot"></span>
                                        }
                                        @msg.Subject
                                    </div>
                                    <div class="msg-preview">
                                        @if (msg.AttachmentFileName != null)
                                        {
                                            <i class="fas fa-paperclip msg-attachment-icon"></i>
                                        }
                                        @(string.IsNullOrEmpty(msg.Body) ? "Žádný obsah" : (msg.Body.Length > 100 ? msg.Body.Substring(0, 100) + "…" : msg.Body))
                                    </div>
                                </div>
                            </a>
                            <div class="msg-actions" onclick="event.stopPropagation();">
                                @if (activeTab == "trash")
                                {
                                    <form asp-action="Restore" method="post" style="display: inline-block;">
                                        @Html.AntiForgeryToken()
                                        <input type="hidden" name="id" value="@msg.SecureId" />
                                        <button type="submit" class="btn-msg-action restore" title="Obnovit z koše">
                                            <i class="fas fa-undo"></i>
                                        </button>
                                    </form>
                                    <form asp-action="DeletePermanently" method="post" style="display: inline-block;" onsubmit="return confirm('Opravdu chcete tuto zprávu trvale smazat?');">
                                        @Html.AntiForgeryToken()
                                        <input type="hidden" name="id" value="@msg.SecureId" />
                                        <button type="submit" class="btn-msg-action delete" title="Smazat trvale">
                                            <i class="fas fa-trash-alt"></i>
                                        </button>
                                    </form>
                                }
                                else
                                {
                                    <form asp-action="Delete" method="post" style="display: inline-block;" onsubmit="return confirm('Opravdu chcete tuto zprávu přesunout do koše?');">
                                        @Html.AntiForgeryToken()
                                        <input type="hidden" name="id" value="@msg.SecureId" />
                                        <button type="submit" class="btn-msg-action delete" title="Přesunout do koše">
                                            <i class="fas fa-trash-alt"></i>
                                        </button>
                                    </form>
                                }
                            </div>
                        </div>
                    }
                </div>
            }
        </div>
    </div>
</div>
