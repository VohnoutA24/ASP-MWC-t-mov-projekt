@model sum.Models.User
@{
    ViewData["Title"] = "Profil";
}

<div class="profile-page">
    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert-success animate-in" style="max-width: 700px; margin: 0 auto 1.5rem;">
            <i class="fas fa-check-circle"></i> @TempData["SuccessMessage"]
        </div>
    }
    @if (TempData["ErrorMessage"] != null)
    {
        <div class="alert-danger animate-in" style="max-width: 700px; margin: 0 auto 1.5rem;">
            <i class="fas fa-exclamation-circle"></i> @TempData["ErrorMessage"]
        </div>
    }

    <div class="profile-card animate-in">
        <div class="profile-header">
            <div class="profile-avatar-container">
                <div class="profile-avatar">
                    @if (Model.ProfilePicture != null)
                    {
                        <img src="@Url.Action("ProfilePicture", "Account", new { userId = Model.Id })" alt="Profilový obrázek" class="profile-avatar-img" />
                    }
                    else
                    {
                        <i class="fas @(Model.Role == "Teacher" ? "fa-chalkboard-teacher" : "fa-user-graduate")"></i>
                    }
                    <button type="button" class="avatar-edit-overlay" onclick="document.getElementById('profilePictureInput').click()" title="Změnit profilový obrázek">
                        <i class="fas fa-camera"></i>
                    </button>
                </div>
                
                @if (Model.ProfilePicture != null)
                {
                    <form asp-controller="Account" asp-action="DeleteProfilePicture" method="post" style="margin-top: 1rem; position: relative; z-index: 2;">
                        @Html.AntiForgeryToken()
                        <button type="submit" class="btn-delete-avatar" title="Smazat profilový obrázek">
                            <i class="fas fa-trash-alt"></i> Smazat obrázek
                        </button>
                    </form>
                }
            </div>
            
            <form id="profilePictureForm" asp-controller="Account" asp-action="UploadProfilePicture" method="post" enctype="multipart/form-data" style="display: none;">
                @Html.AntiForgeryToken()
                <input type="file" id="profilePictureInput" name="file" accept=".png,.jpg,.jpeg,.webp" onchange="document.getElementById('profilePictureForm').submit()" />
            </form>
        </div>
        <div class="profile-body">
            <div class="profile-name">
                <h1>@(Model.FullName ?? Model.Email)</h1>
                <div class="role-badge">
                    <i class="fas fa-shield-alt"></i>
                    @Model.Role
                </div>
            </div>

            <div class="profile-info-grid">
                <div class="profile-info-item">
                    <div class="profile-info-icon" style="background: #d1fae5; color: #065f46;">
                        <i class="fas fa-envelope"></i>
                    </div>
                    <div class="profile-info-text">
                        <div class="info-label">E-mail</div>
                        <div class="info-value">@Model.Email</div>
                    </div>
                </div>

                @if (!string.IsNullOrEmpty(Model.FullName))
                {
                    <div class="profile-info-item">
                        <div class="profile-info-icon" style="background: #ede9fe; color: #5b21b6;">
                            <i class="fas fa-id-card"></i>
                        </div>
                        <div class="profile-info-text">
                            <div class="info-label">Celé jméno</div>
                            <div class="info-value">@Model.FullName</div>
                        </div>
                    </div>
                }

                <div class="profile-info-item">
                    <div class="profile-info-icon" style="background: #fef3c7; color: #92400e;">
                        <i class="fas fa-calendar"></i>
                    </div>
                    <div class="profile-info-text">
                        <div class="info-label">Registrace</div>
                        <div class="info-value">@Model.CreatedAt.ToString("d. MMMM yyyy", new System.Globalization.CultureInfo("cs-CZ"))</div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
