@model List<sum.Models.Homework>
@{
    ViewData["Title"] = "Nástěnka";
    var fullName = User.FindFirst("FullName")?.Value ?? User.Identity?.Name ?? "Student";
    var gradeAvg = ViewBag.GradeAverage ?? 2.4;
    var pendingHomework = ViewBag.PendingHomework ?? 0;
    var unreadMessages = ViewBag.UnreadMessages ?? 0;
}

<div class="dashboard-page">
    <div class="dashboard-header animate-in">
        <h1>👋 Ahoj, @fullName!</h1>
        <p>Tady je přehled tvého dne a studia.</p>
    </div>

    <div class="dashboard-grid">
        <div class="dash-card animate-in animate-delay-1">
            <div class="dash-card-header">
                <h3>Průměr známek</h3>
                <div class="dash-card-icon" style="background: #dbeafe; color: #1e40af;">
                    <i class="fas fa-chart-line"></i>
                </div>
            </div>
            <div class="value" style="color: #1e40af;">@gradeAvg</div>
            <div class="sub">Celkový průměr ze všech předmětů</div>
        </div>

        <div class="dash-card animate-in animate-delay-2">
            <div class="dash-card-header">
                <h3>Docházka</h3>
                <div class="dash-card-icon" style="background: #d1fae5; color: #065f46;">
                    <i class="fas fa-check-circle"></i>
                </div>
            </div>
            <div class="value" style="color: #065f46;">96%</div>
            <div class="sub">3 omluvené absence tento měsíc</div>
        </div>

        <div class="dash-card animate-in animate-delay-3">
            <div class="dash-card-header">
                <h3>Úkoly</h3>
                <div class="dash-card-icon" style="background: #fef3c7; color: #92400e;">
                    <i class="fas fa-tasks"></i>
                </div>
            </div>
            <div class="value" style="color: #92400e;">@pendingHomework</div>
            <div class="sub">Nesplněných úkolů celkem</div>
        </div>

        <div class="dash-card animate-in animate-delay-4">
            <div class="dash-card-header">
                <h3>Zprávy</h3>
                <div class="dash-card-icon" style="background: #ede9fe; color: #5b21b6;">
                    <i class="fas fa-envelope"></i>
                </div>
            </div>
            <div class="value" style="color: #5b21b6;">@unreadMessages</div>
            <div class="sub">Nepřečtené zprávy</div>
        </div>
    </div>

    <div class="homework-section animate-in animate-delay-4" style="margin-top: 2rem; margin-bottom: 2rem;">
        <div class="schedule-card" style="margin-bottom: 0;">
            <h2><i class="fas fa-tasks" style="color: var(--primary);"></i> Aktivní domácí úkoly</h2>
            @if (Model == null || !Model.Any())
            {
                <p style="color: var(--text-secondary); padding: 1rem 0; font-size: 0.95rem;">V tuto chvíli nemáš žádné domácí úkoly. Výborně!</p>
            }
            else
            {
                <div class="table-responsive" style="margin-top: 1rem; overflow-x: auto;">
                    <table class="schedule-table" style="width: 100%;">
                        <thead>
                            <tr>
                                <th>Předmět</th>
                                <th>Název úkolu</th>
                                <th>Popis</th>
                                <th>Zadal(a)</th>
                                <th>Termín odevzdání</th>
                                <th>Stav</th>
                                <th>Akce</th>
                            </tr>
                        </thead>
                        <tbody>
                            @{
                                var completedIds = ViewBag.CompletedHomeworkIds as List<int> ?? new List<int>();
                            }
                            @foreach (var hw in Model)
                            {
                                var isExpired = hw.Deadline < DateTime.UtcNow;
                                var isCompleted = completedIds.Contains(hw.Id);
                                var badgeClass = "badge-subject " + (hw.Subject switch
                                {
                                    "Matematika" => "badge-math",
                                    "Český jazyk" => "badge-czech",
                                    "Anglický jazyk" => "badge-english",
                                    "Fyzika" => "badge-physics",
                                    "Informatika" => "badge-it",
                                    "Chemie" => "badge-chemistry",
                                    "Dějepis" => "badge-history",
                                    "Zeměpis" => "badge-geography",
                                    "Přírodopis" => "badge-biology",
                                    "Občanská výchova" => "badge-civics",
                                    _ => "badge-science"
                                });

                                <tr style="cursor: pointer;" data-bs-toggle="modal" data-bs-target="#homeworkModal"
                                    data-title="@hw.Title"
                                    data-subject="@hw.Subject"
                                    data-badge-class="@badgeClass"
                                    data-description="@hw.Description"
                                    data-teacher="@(hw.Teacher?.FullName ?? "Učitel")"
                                    data-deadline="@hw.Deadline.ToLocalTime().ToString("dd.MM.yyyy HH:mm")"
                                    data-created="@hw.CreatedAt.ToLocalTime().ToString("dd.MM.yyyy HH:mm")">
                                    <td><span class="@badgeClass">@hw.Subject</span></td>
                                    <td style="font-weight: 600; color: var(--primary);">@hw.Title</td>
                                    <td style="max-width: 250px; overflow: hidden; text-overflow: ellipsis; white-space: nowrap;" title="@hw.Description">@hw.Description</td>
                                    <td>@(hw.Teacher?.FullName ?? "Učitel")</td>
                                    <td style="color: @(isExpired ? "var(--danger)" : "inherit"); font-weight: @(isExpired ? "normal" : "600")">
                                        @hw.Deadline.ToLocalTime().ToString("dd.MM.yyyy HH:mm")
                                    </td>
                                    <td>
                                        @if (isCompleted)
                                        {
                                            <span class="badge bg-success" style="font-size: 0.78rem; background-color: var(--success) !important;">Splněno</span>
                                        }
                                        else if (isExpired)
                                        {
                                            <span class="badge bg-secondary" style="font-size: 0.78rem;">Po termínu</span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-primary" style="font-size: 0.78rem; background-color: var(--primary) !important;">Aktivní</span>
                                        }
                                    </td>
                                    <td>
                                        @if (!isCompleted)
                                        {
                                            <form asp-controller="Home" asp-action="CompleteHomework" method="post" style="display:inline;" onclick="event.stopPropagation();">
                                                @Html.AntiForgeryToken()
                                                <input type="hidden" name="id" value="@hw.Id" />
                                                <button type="submit" class="btn-primary-custom" style="padding: 0.25rem 0.65rem; font-size: 0.75rem; border-radius: var(--radius-sm); box-shadow: none;">
                                                    <i class="fas fa-check"></i> Splnit
                                                </button>
                                            </form>
                                        }
                                        else
                                        {
                                            <span style="color: var(--success); font-weight: 600; font-size: 0.85rem;"><i class="fas fa-check-circle"></i> Odevzdáno</span>
                                        }
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
        </div>
    </div>

    <!-- Homework Detail Modal -->
    <div class="modal fade" id="homeworkModal" tabindex="-1" aria-labelledby="homeworkModalLabel" aria-hidden="true">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content" style="border-radius: var(--radius-lg); border: 1px solid var(--border); box-shadow: var(--shadow-lg); background: var(--bg-card); color: var(--text-primary);">
                <div class="modal-header" style="border-bottom: 1px solid var(--border-light); padding: 1.25rem;">
                    <h5 class="modal-title" id="homeworkModalLabel" style="font-weight: 700;">Detail domácího úkolu</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Zavřít" style="filter: var(--theme-close-btn);"></button>
                </div>
                <div class="modal-body" style="padding: 1.5rem;">
                    <div class="mb-3">
                        <span id="modalSubject" class="badge-subject">Předmět</span>
                    </div>
                    <h3 id="modalTitle" style="font-weight: 800; margin-bottom: 1rem; font-size: 1.4rem; color: var(--text-primary);">Název úkolu</h3>
                    
                    <div class="homework-desc-container" style="background: var(--bg-secondary); border-radius: var(--radius-md); padding: 1rem; margin-bottom: 1.25rem; border: 1px solid var(--border-light);">
                        <h4 style="font-size: 0.8rem; font-weight: 700; text-transform: uppercase; color: var(--text-muted); margin-bottom: 0.5rem; letter-spacing: 0.04em;">Popis / Zadání</h4>
                        <p id="modalDescription" style="color: var(--text-secondary); white-space: pre-wrap; margin-bottom: 0; font-size: 0.95rem;"></p>
                    </div>
                    
                    <div class="row g-3" style="font-size: 0.88rem;">
                        <div class="col-6">
                           <div style="color: var(--text-muted); font-size: 0.78rem; text-transform: uppercase; font-weight: 600; letter-spacing: 0.02em;">Zadal(a)</div>
                           <div id="modalTeacher" style="font-weight: 600; margin-top: 0.15rem;">Jméno učitele</div>
                        </div>
                        <div class="col-6">
                           <div style="color: var(--text-muted); font-size: 0.78rem; text-transform: uppercase; font-weight: 600; letter-spacing: 0.02em;">Termín odevzdání</div>
                           <div id="modalDeadline" style="font-weight: 700; color: var(--primary); margin-top: 0.15rem;">Datum a čas</div>
                        </div>
                        <div class="col-12" style="border-top: 1px solid var(--border-light); padding-top: 0.75rem; margin-top: 0.75rem;">
                           <span style="color: var(--text-muted); font-size: 0.75rem;">Zadáno dne: <span id="modalCreated" style="font-weight: 500;">Datum</span></span>
                        </div>
                    </div>
                </div>
                <div class="modal-footer" style="border-top: 1px solid var(--border-light); padding: 1rem 1.25rem;">
                    <button type="button" class="btn-secondary-custom" data-bs-dismiss="modal" style="padding: 0.5rem 1.25rem; font-size: 0.88rem; border-radius: var(--radius-sm);">Zavřít</button>
                </div>
            </div>
        </div>
    </div>

    <div class="dashboard-quick-links animate-in">
        <a asp-controller="Home" asp-action="Timetable" class="quick-link-card">
            <i class="fas fa-calendar-alt"></i>
            <span>Zobrazit rozvrh</span>
        </a>
        <a asp-controller="Home" asp-action="Cafeteria" class="quick-link-card">
            <i class="fas fa-utensils"></i>
            <span>Jídelníček</span>
        </a>
    </div>
</div>

@section Scripts {
    <script>
        document.addEventListener('DOMContentLoaded', function () {
            const homeworkModal = document.getElementById('homeworkModal');
            if (homeworkModal) {
                homeworkModal.addEventListener('show.bs.modal', function (event) {
                    const button = event.relatedTarget;
                    
                    const title = button.getAttribute('data-title');
                    const subject = button.getAttribute('data-subject');
                    const badgeClass = button.getAttribute('data-badge-class');
                    const description = button.getAttribute('data-description') || 'Bez popisu.';
                    const teacher = button.getAttribute('data-teacher');
                    const deadline = button.getAttribute('data-deadline');
                    const created = button.getAttribute('data-created');

                    const modalTitle = homeworkModal.querySelector('#modalTitle');
                    const modalSubject = homeworkModal.querySelector('#modalSubject');
                    const modalDescription = homeworkModal.querySelector('#modalDescription');
                    const modalTeacher = homeworkModal.querySelector('#modalTeacher');
                    const modalDeadline = homeworkModal.querySelector('#modalDeadline');
                    const modalCreated = homeworkModal.querySelector('#modalCreated');

                    modalTitle.textContent = title;
                    modalSubject.textContent = subject;
                    modalSubject.className = badgeClass;
                    modalDescription.textContent = description;
                    modalTeacher.textContent = teacher;
                    modalDeadline.textContent = deadline;
                    modalCreated.textContent = created;
                });
            }
        });
    </script>
}
