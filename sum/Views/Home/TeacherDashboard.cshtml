@model List<sum.Models.Homework>
@{
    ViewData["Title"] = "Učitelská nástěnka";
    var fullName = User.FindFirst("FullName")?.Value ?? User.Identity?.Name ?? "Učitel";
    var unreadMessages = ViewBag.UnreadMessages ?? 0;
    var totalHomeworks = ViewBag.TotalHomeworks ?? 0;
    var activeHomeworks = ViewBag.ActiveHomeworks ?? 0;
}

<div class="dashboard-page">
    <div class="dashboard-header animate-in">
        <h1>🎓 Učitelský portál — @fullName</h1>
        <p>Tady můžete zadávat domácí úkoly studentům a spravovat své zadané práce.</p>
    </div>

    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success animate-in" style="background: #ecfdf5; border: 1px solid #a7f3d0; border-radius: var(--radius-sm); padding: 0.85rem; margin-bottom: 1.5rem; color: #065f46; display: flex; align-items: center; gap: 0.5rem; font-size: 0.9rem;">
            <i class="fas fa-check-circle"></i> @TempData["SuccessMessage"]
        </div>
    }
    @if (TempData["ErrorMessage"] != null)
    {
        <div class="alert alert-danger animate-in" style="background: #fef2f2; border: 1px solid #fecaca; border-radius: var(--radius-sm); padding: 0.85rem; margin-bottom: 1.5rem; color: #b91c1c; display: flex; align-items: center; gap: 0.5rem; font-size: 0.9rem;">
            <i class="fas fa-exclamation-circle"></i> @TempData["ErrorMessage"]
        </div>
    }

    <div class="dashboard-grid">
        <div class="dash-card animate-in animate-delay-1">
            <div class="dash-card-header">
                <h3>Celkem zadaných úkolů</h3>
                <div class="dash-card-icon" style="background: #dbeafe; color: #1e40af;">
                    <i class="fas fa-archive"></i>
                </div>
            </div>
            <div class="value" style="color: #1e40af;">@totalHomeworks</div>
            <div class="sub">Celkový počet vámi zadaných úkolů</div>
        </div>

        <div class="dash-card animate-in animate-delay-2">
            <div class="dash-card-header">
                <h3>Aktivní úkoly</h3>
                <div class="dash-card-icon" style="background: #d1fae5; color: #065f46;">
                    <i class="fas fa-hourglass-half"></i>
                </div>
            </div>
            <div class="value" style="color: #065f46;">@activeHomeworks</div>
            <div class="sub">Úkoly, u kterých ještě nevypršel termín</div>
        </div>

        <div class="dash-card animate-in animate-delay-3">
            <div class="dash-card-header">
                <h3>Zprávy</h3>
                <div class="dash-card-icon" style="background: #ede9fe; color: #5b21b6;">
                    <i class="fas fa-envelope"></i>
                </div>
            </div>
            <div class="value" style="color: #5b21b6;">@unreadMessages</div>
            <div class="sub">Nepřečtené zprávy ve schránce</div>
        </div>
    </div>

    <div class="row">
        <!-- Assign Homework Form -->
        <div class="col-lg-5 animate-in animate-delay-4" style="margin-bottom: 2rem;">
            <div class="schedule-card" style="height: 100%;">
                <h2><i class="fas fa-plus-circle" style="color: var(--primary);"></i> Zadat nový domácí úkol</h2>
                <form asp-controller="Home" asp-action="AssignHomework" method="post" style="margin-top: 1.25rem;">
                    @Html.AntiForgeryToken()
                    
                    <div class="form-group">
                        <label for="subjectSelect">Předmět <span class="required">*</span></label>
                        <select name="subject" id="subjectSelect" class="form-input" style="padding-left: 0.85rem;" required>
                            <option value="">-- Vyberte předmět --</option>
                            <option value="Matematika">Matematika</option>
                            <option value="Český jazyk">Český jazyk</option>
                            <option value="Anglický jazyk">Anglický jazyk</option>
                            <option value="Fyzika">Fyzika</option>
                            <option value="Dějepis">Dějepis</option>
                            <option value="Chemie">Chemie</option>
                            <option value="Zeměpis">Zeměpis</option>
                            <option value="Informatika">Informatika</option>
                            <option value="Občanská výchova">Občanská výchova</option>
                            <option value="Přírodopis">Přírodopis</option>
                            <option value="Tělesná výchova">Tělesná výchova</option>
                            <option value="Výtvarná výchova">Výtvarná výchova</option>
                            <option value="Hudební výchova">Hudební výchova</option>
                        </select>
                    </div>

                    <div class="form-group">
                        <label for="hwTitle">Název úkolu <span class="required">*</span></label>
                        <input type="text" name="title" id="hwTitle" class="form-input" style="padding-left: 0.85rem;" placeholder="Např. Cvičení 14 na straně 42" required maxlength="200" />
                    </div>

                    <div class="form-group">
                        <label for="hwDescription">Popis a instrukce</label>
                        <textarea name="description" id="hwDescription" class="form-input" style="padding-left: 0.85rem; height: 100px; resize: vertical;" placeholder="Popište zadání, odevzdání nebo detaily úkolu..."></textarea>
                    </div>

                    <div class="form-group">
                        <label for="hwDeadline">Termín odevzdání <span class="required">*</span></label>
                        <input type="datetime-local" name="deadline" id="hwDeadline" class="form-input" style="padding-left: 0.85rem;" required />
                    </div>

                    <button type="submit" class="btn-primary-custom" style="width: 100%; justify-content: center; border-radius: var(--radius-sm); margin-top: 0.5rem;">
                        <i class="fas fa-paper-plane"></i> Odeslat zadání
                    </button>
                </form>
            </div>
        </div>

        <!-- Assigned Homework List -->
        <div class="col-lg-7 animate-in animate-delay-4" style="margin-bottom: 2rem;">
            <div class="schedule-card" style="height: 100%;">
                <h2><i class="fas fa-list-ul" style="color: var(--primary);"></i> Přehled vašich zadaných úkolů</h2>
                @if (Model == null || !Model.Any())
                {
                    <p style="color: var(--text-secondary); padding: 1.5rem 0; font-size: 0.95rem;">Zatím jste nezadal(a) žádné úkoly. Použijte formulář vlevo.</p>
                }
                else
                {
                    <div class="table-responsive" style="margin-top: 1rem; overflow-x: auto;">
                        <table class="schedule-table" style="width: 100%;">
                            <thead>
                                <tr>
                                    <th>Předmět</th>
                                    <th>Název</th>
                                    <th>Termín</th>
                                    <th>Stav</th>
                                    <th>Akce</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var hw in Model)
                                {
                                    var isExpired = hw.Deadline < DateTime.UtcNow;
                                    var badgeClass = "badge-subject " + (hw.Subject switch
                                    {
                                        "Matematika" => "badge-math",
                                        "Český jazyk" => "badge-czech",
                                        "Anglický jazyk" => "badge-english",
                                        "Fyzika" => "badge-physics",
                                        "Informatika" => "badge-it",
                                        "Chemie" => "badge-chemistry",
                                        "Dějepis" => "badge-history",
                                        "Zeměpis" => "badge-geography",
                                        "Přírodopis" => "badge-biology",
                                        "Občanská výchova" => "badge-civics",
                                        _ => "badge-science"
                                    });

                                    <tr style="cursor: pointer;" data-bs-toggle="modal" data-bs-target="#homeworkModal"
                                        data-title="@hw.Title"
                                        data-subject="@hw.Subject"
                                        data-badge-class="@badgeClass"
                                        data-description="@hw.Description"
                                        data-teacher="@fullName"
                                        data-deadline="@hw.Deadline.ToCzechTime().ToString("dd.MM.yyyy HH:mm")"
                                        data-created="@hw.CreatedAt.ToCzechTime().ToString("dd.MM.yyyy HH:mm")">
                                        <td><span class="@badgeClass">@hw.Subject</span></td>
                                        <td style="font-weight: 600; color: var(--primary);">@hw.Title</td>
                                        <td style="color: @(isExpired ? "var(--danger)" : "inherit"); font-weight: @(isExpired ? "normal" : "600")">
                                            @hw.Deadline.ToCzechTime().ToString("dd.MM.yyyy HH:mm")
                                        </td>
                                        <td>
                                            @if (isExpired)
                                            {
                                                <span class="badge bg-secondary" style="font-size: 0.78rem;">Uzavřený</span>
                                            }
                                            else
                                            {
                                                <span class="badge bg-success" style="font-size: 0.78rem; background-color: var(--success) !important;">Aktivní</span>
                                            }
                                        </td>
                                        <td>
                                            <form asp-controller="Home" asp-action="DeleteHomework" method="post" style="display:inline;" onsubmit="return confirm('Opravdu chcete smazat tento úkol?');" onclick="event.stopPropagation();">
                                                @Html.AntiForgeryToken()
                                                <input type="hidden" name="id" value="@hw.Id" />
                                                <button type="submit" class="btn-logout" style="padding: 0.25rem 0.5rem; font-size: 0.78rem; border-color: #fecaca; background: #fef2f2; color: #b91c1c;">
                                                    <i class="fas fa-trash-alt"></i> Smazat
                                                </button>
                                            </form>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }
            </div>
        </div>
    </div>

    <!-- Homework Detail Modal -->
    <div class="modal fade" id="homeworkModal" tabindex="-1" aria-labelledby="homeworkModalLabel" aria-hidden="true">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content" style="border-radius: var(--radius-lg); border: 1px solid var(--border); box-shadow: var(--shadow-lg); background: var(--bg-card); color: var(--text-primary);">
                <div class="modal-header" style="border-bottom: 1px solid var(--border-light); padding: 1.25rem;">
                    <h5 class="modal-title" id="homeworkModalLabel" style="font-weight: 700;">Detail domácího úkolu</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Zavřít" style="filter: var(--theme-close-btn);"></button>
                </div>
                <div class="modal-body" style="padding: 1.5rem;">
                    <div class="mb-3">
                        <span id="modalSubject" class="badge-subject">Předmět</span>
                    </div>
                    <h3 id="modalTitle" style="font-weight: 800; margin-bottom: 1rem; font-size: 1.4rem; color: var(--text-primary);">Název úkolu</h3>
                    
                    <div class="homework-desc-container" style="background: var(--bg-secondary); border-radius: var(--radius-md); padding: 1rem; margin-bottom: 1.25rem; border: 1px solid var(--border-light);">
                        <h4 style="font-size: 0.8rem; font-weight: 700; text-transform: uppercase; color: var(--text-muted); margin-bottom: 0.5rem; letter-spacing: 0.04em;">Popis / Zadání</h4>
                        <p id="modalDescription" style="color: var(--text-secondary); white-space: pre-wrap; margin-bottom: 0; font-size: 0.95rem;"></p>
                    </div>
                    
                    <div class="row g-3" style="font-size: 0.88rem;">
                        <div class="col-6">
                           <div style="color: var(--text-muted); font-size: 0.78rem; text-transform: uppercase; font-weight: 600; letter-spacing: 0.02em;">Zadal(a)</div>
                           <div id="modalTeacher" style="font-weight: 600; margin-top: 0.15rem;">Jméno učitele</div>
                        </div>
                        <div class="col-6">
                           <div style="color: var(--text-muted); font-size: 0.78rem; text-transform: uppercase; font-weight: 600; letter-spacing: 0.02em;">Termín odevzdání</div>
                           <div id="modalDeadline" style="font-weight: 700; color: var(--primary); margin-top: 0.15rem;">Datum a čas</div>
                        </div>
                        <div class="col-12" style="border-top: 1px solid var(--border-light); padding-top: 0.75rem; margin-top: 0.75rem;">
                           <span style="color: var(--text-muted); font-size: 0.75rem;">Zadáno dne: <span id="modalCreated" style="font-weight: 500;">Datum</span></span>
                        </div>
                    </div>
                </div>
                <div class="modal-footer" style="border-top: 1px solid var(--border-light); padding: 1rem 1.25rem;">
                    <button type="button" class="btn-secondary-custom" data-bs-dismiss="modal" style="padding: 0.5rem 1.25rem; font-size: 0.88rem; border-radius: var(--radius-sm);">Zavřít</button>
                </div>
            </div>
        </div>
    </div>

    <div class="dashboard-quick-links animate-in" style="margin-top: 1rem;">
        <a asp-controller="Messages" asp-action="Index" class="quick-link-card">
            <i class="fas fa-envelope"></i>
            <span>Přejít do pošty</span>
        </a>
        <a asp-controller="Home" asp-action="Timetable" class="quick-link-card">
            <i class="fas fa-calendar-alt"></i>
            <span>Zobrazit rozvrh</span>
        </a>
    </div>
</div>

@section Scripts {
    <script>
        document.addEventListener('DOMContentLoaded', function () {
            // Pre-fill datetime-local min attribute with current time (CZ format adaptation)
            const deadlineInput = document.getElementById('hwDeadline');
            if (deadlineInput) {
                const now = new Date();
                const year = now.getFullYear();
                const month = String(now.getMonth() + 1).padStart(2, '0');
                const day = String(now.getDate()).padStart(2, '0');
                const hours = String(now.getHours()).padStart(2, '0');
                const minutes = String(now.getMinutes()).padStart(2, '0');
                
                deadlineInput.min = `${year}-${month}-${day}T${hours}:${minutes}`;
            }

            const homeworkModal = document.getElementById('homeworkModal');
            if (homeworkModal) {
                homeworkModal.addEventListener('show.bs.modal', function (event) {
                    const button = event.relatedTarget;
                    
                    const title = button.getAttribute('data-title');
                    const subject = button.getAttribute('data-subject');
                    const badgeClass = button.getAttribute('data-badge-class');
                    const description = button.getAttribute('data-description') || 'Bez popisu.';
                    const teacher = button.getAttribute('data-teacher');
                    const deadline = button.getAttribute('data-deadline');
                    const created = button.getAttribute('data-created');

                    const modalTitle = homeworkModal.querySelector('#modalTitle');
                    const modalSubject = homeworkModal.querySelector('#modalSubject');
                    const modalDescription = homeworkModal.querySelector('#modalDescription');
                    const modalTeacher = homeworkModal.querySelector('#modalTeacher');
                    const modalDeadline = homeworkModal.querySelector('#modalDeadline');
                    const modalCreated = homeworkModal.querySelector('#modalCreated');

                    modalTitle.textContent = title;
                    modalSubject.textContent = subject;
                    modalSubject.className = badgeClass;
                    modalDescription.textContent = description;
                    modalTeacher.textContent = teacher;
                    modalDeadline.textContent = deadline;
                    modalCreated.textContent = created;
                });
            }
        });
    </script>
}
