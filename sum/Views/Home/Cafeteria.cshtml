@{
    ViewData["Title"] = "Jídelna";
}

<div class="cafeteria-page">
    <div class="cafeteria-header animate-in">
        <h1><i class="fas fa-utensils"></i> Školní jídelna</h1>
        <p>Základní škola Chvalkovice · Suterén budovy</p>
    </div>

    <div class="cafeteria-info animate-in">
        <div class="info-card">
            <i class="fas fa-clock"></i>
            <div>
                <strong>Výdej obědů</strong>
                <span>11:30 – 14:00</span>
            </div>
        </div>
        <div class="info-card">
            <i class="fas fa-map-marker-alt"></i>
            <div>
                <strong>Umístění</strong>
                <span>Suterén, místnost S01</span>
            </div>
        </div>
        <div class="info-card">
            <i class="fas fa-money-bill-wave"></i>
            <div>
                <strong>Cena oběda</strong>
                <span>32 Kč / den</span>
            </div>
        </div>
    </div>

    <div class="menu-week animate-in">
        <h2><i class="fas fa-list-alt"></i> Jídelníček na tento týden</h2>

        <div class="menu-day">
            <div class="menu-day-header">
                <span class="menu-day-name">Pondělí</span>
            </div>
            <div class="menu-day-body">
                <div class="menu-item">
                    <span class="menu-label">Polévka</span>
                    <span class="menu-food">Krupicová polévka s vejcem a kořenovou zeleninou</span>
                </div>
                <div class="menu-item">
                    <span class="menu-label">Oběd 1</span>
                    <span class="menu-food">Znojemská hovězí pečeně, dušená rýže</span>
                </div>
                <div class="menu-item">
                    <span class="menu-label">Oběd 2</span>
                    <span class="menu-food">Francouzské zapékané brambory s uzeným masem, kyselá okurka</span>
                </div>
            </div>
        </div>

        <div class="menu-day">
            <div class="menu-day-header">
                <span class="menu-day-name">Úterý</span>
            </div>
            <div class="menu-day-body">
                <div class="menu-item">
                    <span class="menu-label">Polévka</span>
                    <span class="menu-food">Hrachová krémová polévka s krutony</span>
                </div>
                <div class="menu-item">
                    <span class="menu-label">Oběd 1</span>
                    <span class="menu-food">Kuřecí plátek na broskvi zapékaný se sýrem, hranolky</span>
                </div>
                <div class="menu-item">
                    <span class="menu-label">Oběd 2</span>
                    <span class="menu-food">Tradiční rýžový nákyp s meruňkami a tvarohem sypaný cukrem</span>
                </div>
            </div>
        </div>

        <div class="menu-day">
            <div class="menu-day-header">
                <span class="menu-day-name">Středa</span>
            </div>
            <div class="menu-day-body">
                <div class="menu-item">
                    <span class="menu-label">Polévka</span>
                    <span class="menu-food">Frankfurtská polévka s bramborem a párkem</span>
                </div>
                <div class="menu-item">
                    <span class="menu-label">Oběd 1</span>
                    <span class="menu-food">Domácí sekaná pečeně, bramborová kaše, okurkový salát</span>
                </div>
                <div class="menu-item">
                    <span class="menu-label">Oběd 2</span>
                    <span class="menu-food">Sladké dukátové buchtičky s teplým vanilkovým krémem</span>
                </div>
            </div>
        </div>

        <div class="menu-day">
            <div class="menu-day-header">
                <span class="menu-day-name">Čtvrtek</span>
            </div>
            <div class="menu-day-body">
                <div class="menu-item">
                    <span class="menu-label">Polévka</span>
                    <span class="menu-food">Jemná rajská polévka s kapáním</span>
                </div>
                <div class="menu-item">
                    <span class="menu-label">Oběd 1</span>
                    <span class="menu-food">Vepřové výpečky, dušený špenát, bramborový knedlík</span>
                </div>
                <div class="menu-item">
                    <span class="menu-label">Oběd 2</span>
                    <span class="menu-food">Kuskusový salát se směsí grilované zeleniny, bylinek a balkánského sýru</span>
                </div>
            </div>
        </div>

        <div class="menu-day">
            <div class="menu-day-header">
                <span class="menu-day-name">Pátek</span>
            </div>
            <div class="menu-day-body">
                <div class="menu-item">
                    <span class="menu-label">Polévka</span>
                    <span class="menu-food">Jarní květáková polévka s krupicí</span>
                </div>
                <div class="menu-item">
                    <span class="menu-label">Oběd 1</span>
                    <span class="menu-food">Smažené rybí filé, domácí bramborový salát</span>
                </div>
                <div class="menu-item">
                    <span class="menu-label">Oběd 2</span>
                    <span class="menu-food">Čočka na kyselo, vařené vejce, sterilovaná okurka, chléb</span>
                </div>
            </div>
        </div>
    </div>
</div>
