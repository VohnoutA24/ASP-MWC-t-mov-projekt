@model sum.Models.TimetableViewModel
@{
    ViewData["Title"] = "Rozvrh hodin";
}

<div class="timetable-page">
    <div class="timetable-header animate-in">
        <h1><i class="fas fa-calendar-alt"></i> Rozvrh hodin – @Model.CurrentGrade. třída</h1>
        <p>Školní rok 2025/2026</p>

        <div class="mt-4 class-selector" style="display: flex; flex-direction: column; align-items: center; gap: 10px;">
            <span class="fw-bold" style="color: var(--text-color);">Vyberte třídu:</span>
            <div class="d-flex flex-wrap justify-content-center gap-2">
                @foreach (var grade in Model.AvailableGrades)
                {
                    <a asp-controller="Home" asp-action="Timetable" asp-route-grade="@grade" class="btn @(grade == Model.CurrentGrade ? "btn-primary" : "btn-outline-primary")" style="border-radius: 20px; padding: 5px 15px;">@grade. třída</a>
                }
            </div>
        </div>
    </div>

    <div class="timetable-slider animate-in mt-4">
        <div class="timetable-viewport" id="ttViewport">
            @foreach (var day in Model.Days)
            {
                <div class="timetable-day" data-day="@day.DayIndex">
                    <h2><i class="fas fa-calendar-day"></i> @day.DayName</h2>
                    <table class="schedule-table">
                        <thead>
                            <tr>
                                <th>Hod.</th>
                                <th>Čas</th>
                                <th>Předmět</th>
                                <th>Učitel</th>
                                <th>Učebna</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var lesson in day.Lessons)
                            {
                                if (lesson.IsDoubleLessonTop)
                                {
                                    <tr class="double-lesson-top">
                                        <td>@lesson.PeriodNumber.</td>
                                        <td>@lesson.TimeRange</td>
                                        <td rowspan="2"><span class="badge-subject @lesson.SubjectBadgeClass">@lesson.Subject</span></td>
                                        <td>@lesson.Teacher</td>
                                        <td>@lesson.Room</td>
                                    </tr>
                                }
                                else if (lesson.IsDoubleLessonBottom)
                                {
                                    <tr class="double-lesson-bottom">
                                        <td>@lesson.PeriodNumber.</td>
                                        <td>@lesson.TimeRange</td>
                                        <td>@lesson.Teacher</td>
                                        <td>@lesson.Room</td>
                                    </tr>
                                }
                                else
                                {
                                    <tr>
                                        <td>@lesson.PeriodNumber.</td>
                                        <td>@lesson.TimeRange</td>
                                        <td><span class="badge-subject @lesson.SubjectBadgeClass">@lesson.Subject</span></td>
                                        <td>@lesson.Teacher</td>
                                        <td>@lesson.Room</td>
                                    </tr>
                                }
                            }
                        </tbody>
                    </table>
                </div>
            }
        </div>
    </div>

    <div class="timetable-dots" id="ttDots">
        @foreach (var day in Model.Days)
        {
            <button class="tt-dot @(day.DayIndex == 0 ? "active" : "")" data-day="@day.DayIndex">@day.DayName.Substring(0, 2)</button>
        }
    </div>
</div>

@section Scripts {
    <script>
        (function () {
            const days = document.querySelectorAll('.timetable-day');
            const dots = document.querySelectorAll('.tt-dot');
            let current = new Date().getDay() - 1;
            if (current < 0 || current > 4) current = 0;

            function show(i) {
                current = Math.max(0, Math.min(4, i));
                days.forEach((d, idx) => {
                    d.classList.toggle('active', idx === current);
                });
                dots.forEach((d, idx) => {
                    d.classList.toggle('active', idx === current);
                });
            }

            dots.forEach(d => d.addEventListener('click', () => show(+d.dataset.day)));

            // Synchronize hover for double lessons
            document.querySelectorAll('.double-lesson-top, .double-lesson-bottom').forEach(row => {
                row.addEventListener('mouseenter', () => {
                    const parent = row.parentElement;
                    const rows = Array.from(parent.children);
                    const idx = rows.indexOf(row);
                    if (row.classList.contains('double-lesson-top')) {
                        rows[idx + 1]?.classList.add('hover-sync');
                    } else {
                        rows[idx - 1]?.classList.add('hover-sync');
                    }
                });
                row.addEventListener('mouseleave', () => {
                    const parent = row.parentElement;
                    Array.from(parent.children).forEach(r => r.classList.remove('hover-sync'));
                });
            });

            show(current);
        })();
    </script>
}
