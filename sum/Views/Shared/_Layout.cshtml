@inject sum.Data.AppDbContext DbContext
@inject Microsoft.AspNetCore.DataProtection.IDataProtectionProvider DataProtectionProvider
@using System.Security.Claims
@using Microsoft.AspNetCore.DataProtection
@{
    var protector = DataProtectionProvider.CreateProtector("sum.AccountController.ActiveAccounts");
    var activeAccounts = new List<sum.Controllers.AccountController.ActiveAccountDto>();
    var activeAccountsCookie = Context.Request.Cookies["ActiveAccounts"];
    if (!string.IsNullOrEmpty(activeAccountsCookie))
    {
        try
        {
            var decrypted = protector.Unprotect(activeAccountsCookie);
            activeAccounts = System.Text.Json.JsonSerializer.Deserialize<List<sum.Controllers.AccountController.ActiveAccountDto>>(decrypted) 
                ?? new List<sum.Controllers.AccountController.ActiveAccountDto>();
        }
        catch { }
    }

    int unreadMessagesCount = 0;
    int pendingHomeworkCount = 0;
    if (User.Identity?.IsAuthenticated == true)
    {
        var userIdClaim = User.FindFirst("UserId")?.Value;
        if (int.TryParse(userIdClaim, out int userId))
        {
            unreadMessagesCount = DbContext.Messages.Count(m => m.RecipientId == userId && !m.IsRead && !m.RecipientDeleted);
            var roleClaim = User.FindFirst(ClaimTypes.Role)?.Value;
            if (roleClaim == "Student")
            {
                pendingHomeworkCount = DbContext.Homeworks.Count(h => h.Deadline > DateTime.UtcNow && !DbContext.HomeworkCompletions.Any(hc => hc.StudentId == userId && hc.HomeworkId == h.Id));
            }
            else if (roleClaim == "Teacher")
            {
                pendingHomeworkCount = DbContext.Homeworks.Count(h => h.TeacherId == userId && h.Deadline > DateTime.UtcNow);
            }
        }
    }
}
<!DOCTYPE html>
<html lang="cs">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content="Základní škola Chvalkovice - školní informační systém pro přihlášení, rozvrh, známky a další." />
    <title>@ViewData["Title"] - ZŠ Chvalkovice</title>
    <script type="importmap"></script>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css" />
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/sum.styles.css" asp-append-version="true" />
    <script>
        (function() {
            const savedTheme = localStorage.getItem('theme') || 'light';
            document.documentElement.setAttribute('data-theme', savedTheme);
        })();
    </script>
</head>
<body>
    <header>
        <nav class="school-nav" id="mainNav">
            <div class="nav-container">
                <a class="nav-brand" asp-area="" asp-controller="Home" asp-action="Index">
                    <div class="brand-icon">
                        <i class="fas fa-graduation-cap"></i>
                    </div>
                    <span class="brand-text">ZŠ Chvalkovice</span>
                </a>
                <button class="nav-toggle" type="button" id="navToggle" aria-label="Toggle navigation">
                    <span></span>
                    <span></span>
                    <span></span>
                </button>
                <div class="nav-menu" id="navMenu">
                    <ul class="nav-links">
                        <li>
                            <a class="nav-link" asp-area="" asp-controller="Home" asp-action="Index">
                                <i class="fas fa-home"></i> Domů
                            </a>
                        </li>
                        <li>
                            <a class="nav-link" asp-area="" asp-controller="Home" asp-action="Timetable">
                                <i class="fas fa-calendar-alt"></i> Rozvrh
                            </a>
                        </li>
                        <li>
                            <a class="nav-link" asp-area="" asp-controller="Home" asp-action="Cafeteria">
                                <i class="fas fa-utensils"></i> Jídelna
                            </a>
                        </li>
                        @if (User.Identity?.IsAuthenticated == true)
                        {
                            <li>
                                <a class="nav-link" asp-area="" asp-controller="Home" asp-action="Dashboard">
                                    <i class="fas fa-tachometer-alt"></i> Nástěnka
                                    @if (pendingHomeworkCount > 0)
                                    {
                                        <span class="badge bg-danger rounded-pill floaty-badge">@pendingHomeworkCount</span>
                                    }
                                </a>
                            </li>
                            <li>
                                <a class="nav-link" asp-area="" asp-controller="Messages" asp-action="Index">
                                    <i class="fas fa-envelope"></i> Pošta
                                    @if (unreadMessagesCount > 0)
                                    {
                                        <span class="badge bg-danger rounded-pill floaty-badge">@unreadMessagesCount</span>
                                    }
                                </a>
                            </li>
                            <li>
                                <a class="nav-link" asp-area="" asp-controller="Account" asp-action="Profile">
                                    <i class="fas fa-user"></i> Profil
                                </a>
                            </li>
                        }
                    </ul>
                    <div class="nav-auth">
                        @if (User.Identity?.IsAuthenticated == true)
                        {
                            var currentUserIdClaim = User.FindFirst("UserId")?.Value;
                            int.TryParse(currentUserIdClaim, out var currentUserId);
                            var currentFullName = User.FindFirst("FullName")?.Value ?? User.Identity.Name;

                            <div class="account-switcher-dropdown">
                                <button type="button" class="user-badge" id="accountSwitcherBtn" onclick="toggleAccountDropdown(event)">
                                    <div class="user-avatar" style="width: 24px; height: 24px; border-radius: 50%; background: var(--primary-50); color: var(--primary); display: flex; align-items: center; justify-content: center; font-size: 0.85rem;">
                                        <i class="fas fa-user-circle"></i>
                                    </div>
                                    <span class="user-name">@currentFullName</span>
                                    <i class="fas fa-chevron-down" style="font-size: 0.75rem; margin-left: 0.25rem; color: var(--text-secondary);"></i>
                                </button>
                                <div class="account-dropdown-menu" id="accountDropdownMenu">
                                    <div class="dropdown-header">Aktivní účty</div>
                                    
                                    <!-- Current active account indicator -->
                                    <div class="dropdown-item account-item" style="background-color: var(--primary-50); border-left: 3px solid var(--primary); cursor: default; border-bottom: 1px solid var(--border-light);">
                                        <div class="account-avatar @(User.FindFirst(ClaimTypes.Role)?.Value == "Teacher" ? "teacher" : "")">
                                            <i class="fas fa-user"></i>
                                        </div>
                                        <div class="account-details">
                                            <span class="account-name" style="font-weight:600;">@currentFullName <small style="color: var(--primary); font-weight: bold;">(aktivní)</small></span>
                                            <span class="account-email" style="font-size: 0.75rem; color: var(--text-secondary);">@User.Identity.Name</span>
                                        </div>
                                    </div>

                                    @foreach (var acc in activeAccounts.Where(a => a.UserId != currentUserId))
                                    {
                                        <form asp-controller="Account" asp-action="SwitchAccount" method="post" style="margin: 0; padding: 0; width: 100%;">
                                            @Html.AntiForgeryToken()
                                            <input type="hidden" name="userId" value="@acc.UserId" />
                                            <button type="submit" class="dropdown-item account-item" style="width: 100%;">
                                                <div class="account-avatar @(acc.Role == "Teacher" ? "teacher" : "")">
                                                    <i class="fas fa-user"></i>
                                                </div>
                                                <div class="account-details">
                                                    <span class="account-name" style="font-weight:600;">@acc.FullName</span>
                                                    <span class="account-email" style="font-size: 0.75rem; color: var(--text-secondary);">@acc.Email</span>
                                                </div>
                                            </button>
                                        </form>
                                    }
                                    <div class="dropdown-divider"></div>
                                    <a class="dropdown-item action-item" asp-controller="Account" asp-action="Login" asp-route-returnUrl="@Context.Request.Path">
                                        <i class="fas fa-user-plus"></i> Přihlásit jiný účet
                                    </a>
                                    <form asp-controller="Account" asp-action="Logout" method="post" style="width: 100%;">
                                        @Html.AntiForgeryToken()
                                        <button type="submit" class="dropdown-item action-item danger">
                                            <i class="fas fa-sign-out-alt"></i> Odhlásit tento účet
                                        </button>
                                    </form>
                                    <form asp-controller="Account" asp-action="LogoutAll" method="post" style="width: 100%;">
                                        @Html.AntiForgeryToken()
                                        <button type="submit" class="dropdown-item action-item danger">
                                            <i class="fas fa-users-slash"></i> Odhlásit všechny účty
                                        </button>
                                    </form>
                                </div>
                            </div>
                        }
                        else
                        {
                            <a class="btn-nav-login" asp-controller="Account" asp-action="Login" id="navLoginBtn">
                                <i class="fas fa-sign-in-alt"></i> Přihlásit
                            </a>
                            <a class="btn-nav-register" asp-controller="Account" asp-action="Register" id="navRegisterBtn">
                                <i class="fas fa-user-plus"></i> Registrace
                            </a>
                        }
                    </div>
                </div>
            </div>
        </nav>
    </header>

    <main role="main">
        @RenderBody()
    </main>

    <footer class="school-footer">
        <div class="footer-content">
            <div class="footer-grid">
                <div class="footer-section">
                    <h3><i class="fas fa-graduation-cap"></i> ZŠ Chvalkovice</h3>
                    <p>Školní informační systém Základní školy Chvalkovice pro správu studia, známek a komunikace.</p>
                </div>
                <div class="footer-section">
                    <h3>Rychlé odkazy</h3>
                    <ul>
                        <li><a asp-controller="Home" asp-action="Index">Domů</a></li>
                        <li><a asp-controller="Home" asp-action="Timetable">Rozvrh</a></li>
                        <li><a asp-controller="Home" asp-action="Cafeteria">Jídelníček</a></li>
                        <li><a asp-controller="Account" asp-action="Login">Přihlášení</a></li>
                        <li><a asp-controller="Account" asp-action="Register">Registrace</a></li>
                    </ul>
                </div>
                <div class="footer-section">
                    <h3>Kontakt</h3>
                    <p><i class="fas fa-envelope"></i> info&#64;zschvalk.cz</p>
                    <p><i class="fas fa-phone"></i> +420 585 351 225</p>
                    <p><i class="fas fa-map-marker-alt"></i> Chvalkovice, Česká republika</p>
                </div>
            </div>
            <div class="footer-bottom">
                <p>&copy; 2026 Základní škola Chvalkovice. Všechna práva vyhrazena.</p>
                <button id="themeToggle" class="theme-toggle-btn" aria-label="Přepnout tmavý režim">
                    <i class="fas fa-moon"></i>
                    <span>Tmavý režim</span>
                </button>
            </div>
        </div>
    </footer>

    @if (User.Identity?.IsAuthenticated == true)
    {
        <script>
            window.userEmail = "@User.FindFirst(ClaimTypes.Email)?.Value";
        </script>

        <style>
            /* Embedded mailbox help styles to ensure proper rendering even with cached site.css */
            .btn-info-custom {
                display: inline-flex;
                align-items: center;
                gap: 0.5rem;
                padding: 0.45rem 1rem;
                border-radius: var(--radius-full);
                font-size: 0.85rem;
                font-weight: 600;
                font-family: 'Inter', -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;
                cursor: pointer;
                transition: all 0.2s cubic-bezier(0.4, 0, 0.2, 1);
                border: 1px solid var(--border);
                background: var(--bg-card);
                color: var(--text-secondary);
                box-shadow: 0 1px 2px rgba(0, 0, 0, 0.05);
            }

            .btn-info-custom i {
                color: var(--primary);
                font-size: 0.9rem;
                transition: transform 0.2s ease;
            }

            .btn-info-custom:hover {
                border-color: var(--primary);
                color: var(--primary);
                background: var(--primary-50);
                transform: translateY(-1px);
                box-shadow: 0 4px 6px rgba(194, 24, 91, 0.08);
            }

            .btn-info-custom:hover i {
                transform: rotate(15deg) scale(1.1);
            }

            [data-theme="dark"] .btn-info-custom {
                border-color: var(--border);
                background: var(--bg-card);
                color: var(--text-secondary);
            }

            [data-theme="dark"] .btn-info-custom:hover {
                border-color: var(--primary);
                color: var(--primary);
                background: rgba(194, 24, 91, 0.15);
            }

            .info-modal-overlay {
                position: fixed;
                top: 0;
                left: 0;
                width: 100%;
                height: 100%;
                background: rgba(15, 23, 42, 0.6);
                backdrop-filter: blur(8px);
                display: flex;
                align-items: center;
                justify-content: center;
                z-index: 2000;
                animation: fadeIn 0.3s ease;
            }

            .info-modal-card {
                background: var(--bg-card);
                border: 1px solid var(--border);
                border-radius: var(--radius-lg);
                box-shadow: var(--shadow-lg);
                width: 90%;
                max-width: 800px;
                max-height: 85vh;
                display: flex;
                flex-direction: column;
                overflow: hidden;
                animation: fadeInUp 0.4s cubic-bezier(0.16, 1, 0.3, 1);
            }

            .info-modal-header {
                padding: 1.25rem 1.5rem;
                border-bottom: 1px solid var(--border);
                display: flex;
                align-items: center;
                justify-content: space-between;
                background: linear-gradient(135deg, var(--primary-50) 0%, transparent 100%);
            }

            .info-modal-header h2 {
                font-size: 1.25rem;
                font-weight: 700;
                font-family: 'Inter', -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;
                color: var(--text-primary);
                margin: 0;
                display: flex;
                align-items: center;
                gap: 0.5rem;
            }

            .info-modal-close {
                background: none;
                border: none;
                color: var(--text-muted);
                font-size: 1.2rem;
                cursor: pointer;
                transition: var(--transition);
                padding: 0.25rem;
                display: flex;
                align-items: center;
                justify-content: center;
            }

            .info-modal-close:hover {
                color: var(--primary);
                transform: scale(1.1);
            }

            .info-modal-body {
                padding: 0;
                overflow: hidden;
                flex: 1;
                display: grid;
                grid-template-columns: 220px 1fr;
                height: 60vh;
            }

            .info-nav {
                display: flex;
                flex-direction: column;
                gap: 0.35rem;
                border-right: 1px solid var(--border-light);
                padding: 1.5rem 1rem;
                background: var(--bg-secondary);
                overflow-y: auto;
            }

            .info-nav-btn {
                text-align: left;
                background: none;
                border: none;
                padding: 0.65rem 0.85rem;
                border-radius: var(--radius-md);
                font-size: 0.88rem;
                font-weight: 600;
                font-family: 'Inter', -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;
                color: var(--text-secondary);
                cursor: pointer;
                transition: var(--transition);
                display: flex;
                align-items: center;
                gap: 0.5rem;
                width: 100%;
            }

            .info-nav-btn:hover {
                background: var(--bg-tertiary);
                color: var(--text-primary);
            }

            .info-nav-btn.active {
                background: var(--primary-50);
                color: var(--primary);
            }

            .info-content-area {
                padding: 1.5rem;
                overflow-y: auto;
                display: flex;
                flex-direction: column;
                gap: 1.5rem;
            }

            .info-section {
                display: none;
                animation: fadeIn 0.3s ease;
                flex-direction: column;
                gap: 1rem;
            }

            .info-section.active {
                display: flex;
            }

            .info-feature-card {
                background: var(--bg-secondary);
                border: 1px solid var(--border-light);
                border-radius: var(--radius-md);
                padding: 1.25rem;
                display: flex;
                gap: 1rem;
                align-items: flex-start;
                text-align: left;
            }

            .info-feature-icon {
                font-size: 1.35rem;
                color: var(--primary);
                background: var(--primary-50);
                width: 40px;
                height: 40px;
                border-radius: 50%;
                display: flex;
                align-items: center;
                justify-content: center;
                flex-shrink: 0;
            }

            .info-feature-text h4 {
                margin: 0 0 0.35rem 0;
                font-size: 0.95rem;
                font-weight: 600;
                font-family: 'Inter', -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;
                color: var(--text-primary);
            }

            .info-feature-text p {
                margin: 0;
                font-size: 0.85rem;
                font-family: 'Inter', -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;
                color: var(--text-secondary);
                line-height: 1.45;
            }

            .faq-item {
                border: 1px solid var(--border-light);
                border-radius: var(--radius-md);
                overflow: hidden;
                margin-bottom: 0.75rem;
            }

            .faq-question {
                width: 100%;
                text-align: left;
                background: var(--bg-secondary);
                border: none;
                padding: 0.85rem 1.25rem;
                font-size: 0.9rem;
                font-weight: 600;
                font-family: 'Inter', -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;
                color: var(--text-primary);
                cursor: pointer;
                display: flex;
                justify-content: space-between;
                align-items: center;
                transition: var(--transition);
            }

            .faq-question:hover {
                background: var(--bg-tertiary);
                color: var(--primary);
            }

            .faq-question i {
                transition: transform 0.2s ease;
                font-size: 0.8rem;
                color: var(--text-muted);
            }

            .faq-question.active i {
                transform: rotate(180deg);
                color: var(--primary);
            }

            .faq-answer {
                padding: 0;
                max-height: 0;
                overflow: hidden;
                transition: all 0.25s cubic-bezier(0.4, 0, 0.2, 1);
                background: var(--bg-card);
                font-size: 0.85rem;
                font-family: 'Inter', -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;
                color: var(--text-secondary);
                line-height: 1.5;
                text-align: left;
                border-top: 0px solid transparent;
            }

            .faq-answer.open {
                padding: 1rem 1.25rem;
                max-height: 500px;
                border-top: 1px solid var(--border-light);
            }

            /* Dark mode overrides for Info modal */
            [data-theme="dark"] .info-modal-card {
                background: var(--bg-card);
                border-color: var(--border);
            }

            [data-theme="dark"] .info-modal-header {
                border-bottom: 1px solid var(--border);
                background: linear-gradient(135deg, rgba(194, 24, 91, 0.15) 0%, transparent 100%);
            }

            [data-theme="dark"] .info-nav {
                border-right: 1px solid var(--border);
                background: var(--bg-tertiary);
            }

            [data-theme="dark"] .info-nav-btn:hover {
                background: var(--bg-secondary);
            }

            [data-theme="dark"] .info-nav-btn.active {
                background: rgba(194, 24, 91, 0.15);
                color: var(--primary);
            }

            [data-theme="dark"] .info-feature-card {
                background: var(--bg-tertiary);
                border-color: var(--border);
            }

            [data-theme="dark"] .info-feature-icon {
                background: rgba(194, 24, 91, 0.2);
            }

            [data-theme="dark"] .faq-item {
                border-color: var(--border);
            }

            [data-theme="dark"] .faq-question {
                background: var(--bg-tertiary);
            }

            [data-theme="dark"] .faq-question:hover {
                background: var(--bg-secondary);
            }

            [data-theme="dark"] .faq-answer {
                background: var(--bg-card);
            }

            [data-theme="dark"] .faq-answer.open {
                border-top: 1px solid var(--border);
            }

            @@media (max-width: 640px) {
                .info-modal-body {
                    grid-template-columns: 1fr;
                    height: 70vh;
                }
                .info-nav {
                    display: flex;
                    flex-direction: row;
                    overflow-x: auto;
                    border-right: none;
                    border-bottom: 1px solid var(--border-light);
                    padding: 0.75rem 1rem;
                    gap: 0.5rem;
                    width: 100%;
                }
                .info-nav-btn {
                    white-space: nowrap;
                    padding: 0.4rem 0.75rem;
                    width: auto;
                }
            }
        </style>

        <!-- Mailbox Help Info Modal -->
        <div id="mailboxInfoModal" class="info-modal-overlay" style="display: none;">
            <div class="info-modal-card">
                <div class="info-modal-header">
                    <h2><i class="fas fa-circle-info"></i> Nápověda k poště</h2>
                    <button type="button" class="info-modal-close" onclick="closeMailboxInfoModal()"><i class="fas fa-times"></i></button>
                </div>
                <div class="info-modal-body">
                    <!-- Left Sidebar Nav -->
                    <div class="info-nav">
                        <button type="button" class="info-nav-btn active" onclick="switchInfoTab('e2e-section', this)">
                            <i class="fas fa-shield-halved"></i> Šifrování E2E
                        </button>
                        <button type="button" class="info-nav-btn" onclick="switchInfoTab('features-section', this)">
                            <i class="fas fa-envelope-open-text"></i> Funkce schránky
                        </button>
                        <button type="button" class="info-nav-btn" onclick="switchInfoTab('embedding-section', this)">
                            <i class="fas fa-photo-film"></i> Přílohy a náhledy
                        </button>
                        <button type="button" class="info-nav-btn" onclick="switchInfoTab('faq-section', this)">
                            <i class="fas fa-circle-question"></i> Časté dotazy
                        </button>
                    </div>

                    <!-- Right Content Area -->
                    <div class="info-content-area">
                        <!-- Section 1: E2E -->
                        <div id="e2e-section" class="info-section active">
                            <h3>Koncové šifrování (End-to-End Encryption)</h3>
                            <p>Tato aplikace využívá moderní zabezpečení, kdy jsou všechny vaše zprávy chráněny přímo ve vašem prohlížeči. Server plní pouze roli přenašeče zašifrovaných dat a nemá k nim přístup.</p>
                            
                            <div class="info-feature-card">
                                <div class="info-feature-icon"><i class="fas fa-lock"></i></div>
                                <div class="info-feature-text">
                                    <h4>Bezpečné odeslání</h4>
                                    <p>Před odesláním zprávy vyhledá váš prohlížeč veřejný klíč příjemce, zprávu zašifruje symetrickým AES-256 klíčem a ten poté zašifruje veřejným klíčem příjemce i vaším veřejným klíčem. Server obdrží pouze nečitelná data.</p>
                                </div>
                            </div>
                            <div class="info-feature-card">
                                <div class="info-feature-icon"><i class="fas fa-key"></i></div>
                                <div class="info-feature-text">
                                    <h4>Dešifrování na zařízení</h4>
                                    <p>Dešifrování probíhá lokálně ve vašem počítači nebo telefonu pomocí vašeho soukromého klíče, který je v zašifrované podobě uložen na serveru a k jehož odemčení je vyžadováno vaše přihlašovací heslo.</p>
                                </div>
                            </div>
                            
                            <div class="alert alert-warning" style="margin-top: 0.5rem; font-size: 0.85rem;">
                                <i class="fas fa-exclamation-triangle"></i> <strong>DŮLEŽITÉ:</strong> Pokud zapomenete své heslo, nikdo (ani administrátor) nebude schopen obnovit vaše dřívější šifrované zprávy, protože váš soukromý klíč je zašifrován právě tímto heslem.
                            </div>
                        </div>

                        <!-- Section 2: Features -->
                        <div id="features-section" class="info-section">
                            <h3>Funkce školní schránky</h3>
                            <p>Školní pošta vám umožňuje komunikovat s učiteli i ostatními studenty v bezpečném prostředí.</p>
                            
                            <div class="info-feature-card">
                                <div class="info-feature-icon"><i class="fas fa-inbox"></i></div>
                                <div class="info-feature-text">
                                    <h4>Doručená a odeslaná pošta</h4>
                                    <p>V Doručené poště naleznete všechny příchozí e-maily. Nové (nepřečtené) zprávy jsou zvýrazněny růžovým bodem. V Odeslané poště najdete historii vámi napsaných zpráv.</p>
                                </div>
                            </div>
                            <div class="info-feature-card">
                                <div class="info-feature-icon"><i class="fas fa-trash-alt"></i></div>
                                <div class="info-feature-text">
                                    <h4>Automatický koš a mazání</h4>
                                    <p>Zprávy přesunuté do Koše jsou po dobu 15 dnů chráněny před trvalým smazáním a můžete je obnovit. Po 15 dnech jsou automaticky a nenávratně odstraněny.</p>
                                </div>
                            </div>
                            <div class="info-feature-card">
                                <div class="info-feature-icon"><i class="fas fa-list-check"></i></div>
                                <div class="info-feature-text">
                                    <h4>Hromadná správa</h4>
                                    <p>Označením více zpráv pomocí zaškrtávacích políček na levé straně můžete provádět hromadné akce, jako je smazání nebo obnova více zpráv najednou.</p>
                                </div>
                            </div>
                        </div>

                        <!-- Section 3: Previews and Attachments -->
                        <div id="embedding-section" class="info-section">
                            <h3>Bezpečné přílohy a náhledy</h3>
                            <p>Můžete bezpečně posílat přílohy (obrázky, videa, PDF a další) do velikosti 25 MB. Všechny soubory jsou před nahráním zašifrovány.</p>
                            
                            <div class="info-feature-card">
                                <div class="info-feature-icon"><i class="fas fa-file-shield"></i></div>
                                <div class="info-feature-text">
                                    <h4>Šifrované ukládání</h4>
                                    <p>Na server se odesílá pouze zašifrovaný proud dat a název souboru. Server nezná obsah souboru ani jeho skutečný název.</p>
                                </div>
                            </div>
                            <div class="info-feature-card">
                                <div class="info-feature-icon"><i class="fas fa-image"></i></div>
                                <div class="info-feature-text">
                                    <h4>Zobrazení náhledů (Embedding)</h4>
                                    <p>U obrázků a video souborů provede prohlížeč stažení zašifrovaného souboru na pozadí, dešifruje jej pomocí klíče zprávy a vytvoří bezpečný náhled přímo v detailu zprávy bez jakéhokoliv vystavení souboru serveru.</p>
                                </div>
                            </div>
                        </div>

                        <!-- Section 4: FAQ -->
                        <div id="faq-section" class="info-section">
                            <h3>Časté dotazy (FAQ)</h3>
                            
                            <div class="faq-item">
                                <button type="button" class="faq-question" onclick="toggleFaq(this)">
                                    Může si správce nebo ředitel přečíst mé zprávy? <i class="fas fa-chevron-down"></i>
                                </button>
                                <div class="faq-answer">
                                    Ne. Veškeré dešifrování probíhá výhradně ve vašem prohlížeči. V databázi a na serveru jsou uloženy pouze zašifrované texty, které bez vašeho soukromého klíče (který administrátor nezná a nemá k němu heslo) nelze přečíst.
                                </div>
                            </div>

                            <div class="faq-item">
                                <button type="button" class="faq-question" onclick="toggleFaq(this)">
                                    Proč po mně systém občas chce heslo pro odemčení schránky? <i class="fas fa-chevron-down"></i>
                                </button>
                                <div class="faq-answer">
                                    Váš dešifrovaný soukromý klíč se ukládá pouze do dočasné paměti karty prohlížeče (`sessionStorage`), aby byl maximálně chráněn. Pokud zavřete kartu, prohlížeč nebo se přihlásíte na jiném zařízení, musíte klíč zadáním hesla znovu dešifrovat.
                                </div>
                            </div>

                            <div class="faq-item">
                                <button type="button" class="faq-question" onclick="toggleFaq(this)">
                                    Co se stane, když změním své přihlašovací heslo? <i class="fas fa-chevron-down"></i>
                                </button>
                                <div class="faq-answer">
                                    Momentálně v systému není změna hesla přímo uživatelsky dostupná. Pokud bude v budoucnu přidána, váš soukromý klíč bude před změnou hesla automaticky dešifrován starým heslem a znovu zašifrován heslem novým, aby nedošlo ke ztrátě přístupu ke zprávám.
                                </div>
                            </div>

                            <div class="faq-item">
                                <button type="button" class="faq-question" onclick="toggleFaq(this)">
                                    Mohu poslat šifrovanou zprávu někomu, kdo ještě poštu neotevřel? <i class="fas fa-chevron-down"></i>
                                </button>
                                <div class="faq-answer">
                                    Při prvním otevření pošty si každý uživatel vygeneruje své šifrovací klíče. Pokud uživatel ještě poštu nikdy nenavštívil, nemá vytvořený veřejný klíč a systém vás na to při pokusu o odeslání zprávy upozorní. Jakmile daný uživatel sekci Pošta alespoň jednou navštíví, klíče se mu automaticky vytvoří a bude možné mu psát.
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <script>
            function closeMailboxInfoModal() {
                document.getElementById("mailboxInfoModal").style.display = "none";
            }

            function switchInfoTab(sectionId, btn) {
                const sections = document.querySelectorAll(".info-section");
                sections.forEach(s => s.classList.remove("active"));
                document.getElementById(sectionId).classList.add("active");

                const buttons = document.querySelectorAll(".info-nav-btn");
                buttons.forEach(b => b.classList.remove("active"));
                btn.classList.add("active");
            }

            function toggleFaq(btn) {
                const answer = btn.nextElementSibling;
                btn.classList.toggle("active");
                answer.classList.toggle("open");
            }

            document.addEventListener("click", function (event) {
                const modal = document.getElementById("mailboxInfoModal");
                if (modal && modal.style.display === "flex") {
                    const card = modal.querySelector(".info-modal-card");
                    const isClickInside = card.contains(event.target) || event.target.id === "mailboxInfoBtn" || event.target.closest("#mailboxInfoBtn");
                    if (!isClickInside) {
                        modal.style.display = "none";
                    }
                }
                
                // Toggle info modal visibility from any help button click
                if (event.target && (event.target.id === "mailboxInfoBtn" || event.target.closest("#mailboxInfoBtn"))) {
                    if (modal) modal.style.display = "flex";
                }
            });
        </script>
    }

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    <script src="~/js/e2e.js" asp-append-version="true"></script>
    <script>
        function toggleAccountDropdown(event) {
            event.stopPropagation();
            const menu = document.getElementById("accountDropdownMenu");
            menu.classList.toggle("show");
        }

        document.addEventListener("click", function (event) {
            const menu = document.getElementById("accountDropdownMenu");
            const btn = document.getElementById("accountSwitcherBtn");
            if (menu && menu.classList.contains("show")) {
                const isClickInside = menu.contains(event.target) || (btn && btn.contains(event.target));
                if (!isClickInside) {
                    menu.classList.remove("show");
                }
            }
        });
    </script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
